{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(bash scripts/harness-checks.sh *)",
      "Bash(bash scripts/check-secret-scan.sh *)",
      "Bash(bash scripts/check-compliance-words.sh *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.sh\" fast",
            "timeout": 30,
            "statusMessage": "凭据 / 合规词检查中..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.sh\" lint",
            "timeout": 90,
            "asyncRewake": true,
            "statusMessage": "Go 格式检查中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
