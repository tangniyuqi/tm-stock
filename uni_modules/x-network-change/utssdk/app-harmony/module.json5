{
  "module": {
    "name": "uni_modules__x_network_change",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "usedScene": {
          "when": "inuse"
        }
      },
      {"name": "ohos.permission.GET_NETWORK_INFO"}
    ]
  }
}
