import { UIView, UIColor } from "UIKit"
import { CGFloat } from "CoreFoundation"
import { xBlurOpts } from "../interface.uts"
import { hexToRgb } from "../libs/color.uts"

/**
 * iOS 端背景模糊：UIVisualEffectView + UIViewPropertyAnimator.fractionComplete
 * 实现"精确控制模糊强度"，对齐 web 的 backdrop-filter:blur(Xpx) 体验。
 * - blur: 0~100，连续控制模糊强度
 * - bgColor: 通过 UIColor 的 alpha 通道控制覆盖色透明度（同 web 的 rgba）
 * 实际 UIKit 操作放 XblurUHelper.swift（混编）。
 */
export class XblurU {
	$element : UniNativeViewElement;
	targetView : UIView | null = null;
	config : xBlurOpts;

	constructor(opts : xBlurOpts) {
		this.config = opts;
		this.$element = opts.ele as UniNativeViewElement;
	}

	/** iOS 必须在 onviewinit 后调用 setup()（NSObject init 约束：constructor 内不能调用 self 方法） */
	setup() {
		this.targetView = new UIView()
		this.$element.bindIOSView(this.targetView!);
		this.applyEffect()
	}

	applyEffect() {
		if (this.targetView == null) {
			return
		}
		let view = this.targetView! as UIView
		XblurUHelper.applyBlur(
			to = view,
			blurFraction = new CGFloat(this.blurFraction()),
			backgroundColor = this.parseBgColor()
		)
	}

	updateEffect(bgColor : string, blur : number) {
		this.config.bgColor = bgColor
		this.config.blur = blur
		this.applyEffect()
	}

	/**
	 * 0~100 → 0~1 的连续模糊强度
	 * iOS 的 UIBlurEffect(.regular) 视觉上比 Web/Android 偏弱，整体放大 2 倍对齐体感。
	 */
	private blurFraction() : number {
		let b = this.config.blur * 2.0 / 100.0
		if (b < 0) {
			b = 0
		}
		if (b > 1) {
			b = 1
		}
		return b
	}

	private parseBgColor() : UIColor {
		let rgba = hexToRgb(this.config.bgColor)
		let r = (rgba?.r ?? 255) / 255.0
		let g = (rgba?.g ?? 255) / 255.0
		let b = (rgba?.b ?? 255) / 255.0
		let a = rgba?.a ?? 1.0
		return new UIColor(
			red = new CGFloat(r),
			green = new CGFloat(g),
			blue = new CGFloat(b),
			alpha = new CGFloat(a)
		)
	}
}
