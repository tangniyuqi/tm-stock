const _installApk = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	let filePath:string = (arg['filePath'] as string|null)??""
	if (filePath == null || filePath == '') {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: "filePath参数必填",
			data: null
		} as UTSJSONObject)
	}
	try {
		uni.installApk({
			filePath: filePath,
			success(data) {
				callback?.({
					callbackId: callbackId!,
					success: true,
					errorMessage: null,
					data: data
				} as UTSJSONObject)
			},
			fail(result) {
				callback?.({
					callbackId: callbackId!,
					success: false,
					errorMessage: result,
					data: null
				} as UTSJSONObject)
			}
		})
	} catch (error) {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: "当前运行的基座未包含api uni.installApk，请重新打包自定义基座再运行。‌",
			data: null
		} as UTSJSONObject)
		console.error('当前运行的基座未包含api uni.installApk，请重新打包自定义基座再运行。')
	}

}
const _makePhoneCall = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
