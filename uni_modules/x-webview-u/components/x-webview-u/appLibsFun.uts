const _onKeyboardHeightChange = (callbackId ?: string, params ?: UTSJSONObject, xWebview ?: xWebviewU | null, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	try {
		const onKeyboardHeightChangeId = uni.onKeyboardHeightChange((result) => {
			const backData = {
				callbackId: callbackId!,
				success: true,
				errorMessage: null,
				data: result,
				type: 'onUpdate'
			} as UTSJSONObject
			xWebview!.evaJs(`__handleTmuiResponse('${JSON.stringify(backData)}')`)
		})
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			type: 'active',
			data: { id: onKeyboardHeightChangeId, callbackId: callbackId }
		} as UTSJSONObject)
	} catch (error) {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: "当前运行的基座未包含api uni.onKeyboardHeightChange，请重新打包自定义基座再运行。‌",
			data: null
		} as UTSJSONObject)
		console.error('当前运行的基座未包含api uni.onKeyboardHeightChange，请重新打包自定义基座再运行。')
	}

}
const _offKeyboardHeightChange = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	try {
		let arg = (params ?? {}) as UTSJSONObject
		const onKeyboardHeightChangeId:number|null = (arg['id'] as number|null)??null
		uni.offKeyboardHeightChange(onKeyboardHeightChangeId)
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: null
		} as UTSJSONObject)
	} catch (error) {
		callback?.({
