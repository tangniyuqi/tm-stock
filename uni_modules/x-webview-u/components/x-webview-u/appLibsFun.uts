const _chooseImage = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	arg = arg == null ? ({}) : arg
	let optsRel = (arg == null ? ({}) : arg)
	const opts = JSON.parse<ChooseImageOptions>(JSON.stringify(optsRel)!)!
	opts.success = function (result : ChooseImageSuccess) {
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result
		} as UTSJSONObject)
	}
	opts.fail = function (result : ChooseImageFail) {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: result,
			data: null
		} as UTSJSONObject)
	}
	uni.chooseImage(opts)
}
