// 反馈
const _showModal = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	arg = arg == null ? ({}) : arg
	let optsRel = (arg == null ? ({}) : arg)
	const opts = JSON.parse<ShowModalOptions>(JSON.stringify(optsRel)!)!
	opts.success = (result : UniShowModalResult) => {
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result
		} as UTSJSONObject)
	}
	opts.fail = (result : UniShowModalFail) => {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: null,
			data: result
		} as UTSJSONObject)
	}
	uni.showModal(opts)
}

const _showToast = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null||callback==null) return
	let arg:UTSJSONObject = (params ?? {}) as UTSJSONObject
	
	let title:string = (arg['title'] as string|null)??'标题'
	let icon:string = (arg['icon'] as string|null)??'none'
	let duration:number|null = (arg['duration'] as number|null)??1500
	let mask:boolean|null = (arg['mask'] as boolean|null)??true
	uni.showToast({
		title,
		icon:icon as Icon,
		duration,
		mask,
		success() {
			callback({
				callbackId: callbackId!,
				success: true,
				errorMessage: null,
				data: null
			} as UTSJSONObject)
	
		},
		fail(result) {
			callback({
				callbackId: callbackId!,
				success: false,
				errorMessage: result,
				data: null
			} as UTSJSONObject)
		}
	})
}

