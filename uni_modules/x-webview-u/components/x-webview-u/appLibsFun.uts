const _onLocationChange = (callbackId ?: string, params ?: UTSJSONObject, xWebview ?: xWebviewU | null, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	const activeId = uni.onLocationChange((result) => {
		const backData = {
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result,
			type: 'onUpdate'
		} as UTSJSONObject
		xWebview!.evaJs(`__handleTmuiResponse('${JSON.stringify(backData)}')`)
	})
	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		type: 'active',
		data: { id: activeId, callbackId: callbackId }
	} as UTSJSONObject)
}

const _offLocationChange = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	const id:number|null = (arg['id'] as number|null)??null
	try {
		if (typeof id == 'number') {
			uni.offLocationChange(id)
		}
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: null
		} as UTSJSONObject)
	} catch (error) {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: "当前运行的基座未包含api uni.offLocationChange，请重新打包自定义基座再运行。‌",
			data: null
		} as UTSJSONObject)
		console.error('当前运行的基座未包含api uni.offLocationChange，请重新打包自定义基座再运行。')
	}

}

