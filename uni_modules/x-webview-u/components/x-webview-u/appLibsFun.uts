			errorMessage: "当前运行的基座未包含api uni.offKeyboardHeightChange，请重新打包自定义基座再运行。‌",
			data: null
		} as UTSJSONObject)
		console.error('当前运行的基座未包含api uni.offKeyboardHeightChange，请重新打包自定义基座再运行。')
	}

}
const _setPageStyle = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	// https://doc.dcloud.net.cn/uni-app-x/api/unipage.html#setpagestyle
	let pages = getCurrentPages()
	let page = pages[pages.length - 1]
	page.setPageStyle(params ?? ({} as UTSJSONObject))
	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		data: null
	} as UTSJSONObject)
}
const _getPageStyle = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	// https://doc.dcloud.net.cn/uni-app-x/api/unipage.html#setpagestyle
	let pages = getCurrentPages()
	let page = pages[pages.length - 1]

	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		data: page.getPageStyle()
	} as UTSJSONObject)
}
const _getPage = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	// https://doc.dcloud.net.cn/uni-app-x/api/unipage.html#setpagestyle
	let pages = getCurrentPages()
	let page = pages[pages.length - 1]

	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		data: {
			route: page.route,
			options: page.options,
			pageBody: {
				left: page.pageBody.left,
				right: page.pageBody.right,
				top: page.pageBody.top,
				bottom: page.pageBody.bottom,
				width: page.pageBody.width,
				height: page.pageBody.height,
			},
			safeAreaInsets: page.safeAreaInsets,
			width: page.width,
			height: page.height,
			statusBarHeight: page.statusBarHeight,
		} as UTSJSONObject
	} as UTSJSONObject)
}


