			errorMessage: result,
			data: null
		} as UTSJSONObject)
	}
	uni.startLocationUpdateBackground(opts)
}

//支付
const _requestPayment = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	arg = arg == null ? ({}) : arg
	let optsRel = (arg == null ? ({}) : arg)
	const opts = JSON.parse<RequestPaymentOptions>(JSON.stringify(optsRel)!)!
	opts.success = function (result : RequestPaymentSuccess) {
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result
		} as UTSJSONObject)
	}
	opts.fail = function (result : RequestPaymentFail) {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: result,
			data: null
		} as UTSJSONObject)
	}
	uni.requestPayment(opts)
}

//分享
const _shareWithSystem = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	arg = arg == null ? ({}) : arg
	let optsRel = (arg == null ? ({}) : arg)
	const opts = JSON.parse<ShareWithSystemOptions>(JSON.stringify(optsRel)!)!
	opts.success = function (result : ShareWithSystemSuccess) {
		callback?.({
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result
		} as UTSJSONObject)
	}
	opts.fail = function (result : ShareWithSystemFail) {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: result,
			data: null
		} as UTSJSONObject)
	}
	uni.shareWithSystem(opts)
}

//事件总线。
const _emit = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	const eventName:string = (arg['eventName'] as string|null)??''
	const args:UTSJSONObject = (arg['data'] as UTSJSONObject|null)??{}
	
	if (eventName == '' || eventName == null) {callback?.(null) return;}
	uni.$emit(eventName, args)
	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		data: null
	} as UTSJSONObject)
}
const _on = (callbackId ?: string, params ?: UTSJSONObject, xWebview ?: xWebviewU | null, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) {
		 callback?.(null) 
		 return;
	}
	let arg = (params ?? {}) as UTSJSONObject
	const eventName:string = (arg['eventName'] as string|null)??''
	if (eventName == '' || eventName == null) {
		callback?.(null) 
		return;
	}
	const activeId = uni.$on(eventName, (args ?: UTSJSONObject) => {
		const backData = {
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: args ?? null,
			type: 'onUpdate'
		} as UTSJSONObject
		xWebview!.evaJs(`__handleTmuiResponse('${JSON.stringify(backData)}')`)
	})
	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		type: 'active',
		data: { id: activeId, callbackId: callbackId, eventName }
	} as UTSJSONObject)
}
const _off = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	const eventName:string = (arg['eventName'] as string|null)??''
	const id:number|null = (arg['id'] as number|null)??null
	if (eventName == '' || eventName == null || typeof id != 'number') {
		callback?.(null);
		return;
	}
	uni.$off(eventName, id)
	callback?.({
		callbackId: callbackId!,
		success: true,
		errorMessage: null,
		data: null
	} as UTSJSONObject)
}

export function callMehodAppFun(methodName : string, callbackId ?: string, params ?: UTSJSONObject, xWebview ?: xWebviewU | null, callback ?: uniAppEvaJsTypeCallBackFun) {

	// 根据方法名分发处理 
	switch (methodName) {
		case "$off":
			_off(callbackId, params, callback)
			break
		case "$on":
			_on(callbackId, params, xWebview, callback)
			break
		case "$emit":
			_emit(callbackId, params, callback)
			break
		case "getClipboardData":
			_getClipboardData(callbackId, params, callback)
			break
		case "setClipboardData":
			_setClipboardData(callbackId, params, callback)
			break
		case "shareWithSystem":
			_shareWithSystem(callbackId, params, callback)
			break
		case "requestPayment":
			_requestPayment(callbackId, params, callback)
			break
		case "startLocationUpdateBackground":
			_startLocationUpdateBackground(callbackId, params, callback)
			break
		case "startLocationUpdate":
			_startLocationUpdate(callbackId, params, callback)
			break
		case "stopLocationUpdate":
			_stopLocationUpdate(callbackId, params, callback)
			break
		case "offLocationChangeError":
			_offLocationChangeError(callbackId, params, callback)
			break
		case "onLocationChangeError":
			_onLocationChangeError(callbackId, params, xWebview, callback)
			break
		case "offLocationChange":
			_offLocationChange(callbackId, params, callback)
			break
		case "onLocationChange":
			_onLocationChange(callbackId, params, xWebview, callback)
			break
		case "getLocation":
			_getLocation(callbackId, params, callback)
			break
		case "saveImageToPhotosAlbum":
			_saveImageToPhotosAlbum(callbackId, params, callback)
			break
		case "getImageInfo":
			_getImageInfo(callbackId, params, callback)
			break
		case "compressImage":
			_compressImage(callbackId, params, callback)
			break
		case "chooseVideo":
			_chooseVideo(callbackId, params, callback)
			break
		case "saveVideoToPhotosAlbum":
			_saveVideoToPhotosAlbum(callbackId, params, callback)
			break
		case "getVideoInfo":
			_getVideoInfo(callbackId, params, callback)
			break
		case "compressVideo":
			_compressVideo(callbackId, params, callback)
			break
		case "chooseMedia":
			_chooseMedia(callbackId, params, callback)
			break
		case "chooseFile":
			_chooseFile(callbackId, params, callback)
			break
		case "openDocument":
			_openDocument(callbackId, params, callback)
			break
		case "hideKeyboard":
			_hideKeyboard(callbackId, params, callback)
			break
		case "onKeyboardHeightChange":
			_onKeyboardHeightChange(callbackId, params, xWebview, callback)
			break
		case "offKeyboardHeightChange":
			_offKeyboardHeightChange(callbackId, params, callback)
			break
		case "scanCode":
			_scanCode(callbackId, params, callback)
			break
		case "makePhoneCall":
			_makePhoneCall(callbackId, params, callback)
			break
		case "installApk":
			_installApk(callbackId, params, callback)
			break
		case "uploadFile":
			_uploadFile(callbackId, params, xWebview, callback)
			break
		case "downloadFile":
			_downloadFile(callbackId, params, xWebview, callback)
			break
		case "getNetworkType":
			_getNetworkType(callbackId, params, callback)
			break
		case "openAppAuthorizeSetting":
			_openAppAuthorizeSetting(callbackId, params, callback)
			break
		case "getSystemSetting":
			_getSystemSetting(callbackId, params, callback)
			break
		case "getAppAuthorizeSetting":
			_getAppAuthorizeSetting(callbackId, params, callback)
			break
		case "getWindowInfo":
			_getWindowInfo(callbackId, params, callback)
			break
		case "getSystemInfo":
			_getSystemInfo(callbackId, params, callback)
			break
		case "getDeviceInfo":
			_getDeviceInfo(callbackId, params, callback)
			break
		case "getSystemInfoSync":
			_getSystemInfoSync(callbackId, params, callback)
			break
		case "getAppBaseInfo":
			_getAppBaseInfo(callbackId, params, callback)
			break
		case "setStorage":
			_setStorage(callbackId, params, callback)
			break
		case "setStorageSync":
			_setStorageSync(callbackId, params, callback)
			break
		case "getStorage":
			_getStorage(callbackId, params, callback)
			break
		case "getStorageSync":
			_getStorageSync(callbackId, params, callback)
			break
		case "removeStorage":
			_removeStorage(callbackId, params, callback)
			break
		case "removeStorageSync":
			_removeStorageSync(callbackId, params, callback)
			break

		case "previewImage":
			_previewImage(callbackId, params, callback)
			break
		case "chooseImage":
			_chooseImage(callbackId, params, callback)
			break

		// 页面和路由
		case "getPage":
			_getPage(callbackId, params, callback)
			break
		case "getPageStyle":
			_getPageStyle(callbackId, params, callback)
			break
		case "setPageStyle":
			_setPageStyle(callbackId, params, callback)
			break

		case "exit":
			_exit(callbackId, params, callback)
			break
		case "showModal":
			_showModal(callbackId, params, callback)
			break
		case "hideLoading":
			_hideLoading(callbackId, params, callback)
			break
		case "showLoading":
			_showLoading(callbackId, params, callback)
			break
		case "showToast":
			_showToast(callbackId, params, callback)
			break
		case "switchTab":
			_switchTab(callbackId, params, callback)
			break
		case "reLaunch":
			_reLaunch(callbackId, params, callback)
			break
		case "navigateTo":
			_navigateTo(callbackId, params, callback)
			break
		case "navigateBack":
			_navigateBack(callbackId, params, callback)
			break
		case "redirectTo":
			_redirectTo(callbackId, params, callback)
			break

		default:
			callback?.(null); return
	}

}