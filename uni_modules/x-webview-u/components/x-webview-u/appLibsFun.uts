import { DownLoadTaskHasMap } from './donwLoadTaskIns.uts';
const donwloadIns = DownLoadTaskHasMap.getInstance()
//路由
const _switchTab = (callbackId ?: string, params ?: UTSJSONObject, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	let url:string|null = (arg['url'] as string|null)??''
	if (url == null) { callback?.(null); return }
	uni.switchTab({
		url: url!,
		success() {
			callback?.({
				callbackId: callbackId!,
				success: true,
				errorMessage: null,
				data: null
			} as UTSJSONObject)
		},
		fail(result) {
			callback?.({
				callbackId: callbackId!,
				success: false,
				errorMessage: result,
				data: null
			} as UTSJSONObject)
		}
	})
}

