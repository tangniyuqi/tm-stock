const _downloadFile = (callbackId ?: string, params ?: UTSJSONObject, xWebview ?: xWebviewU | null, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) {
		callback?.(null);
		return;
	}
	let arg = (params ?? {}) as UTSJSONObject
	const url:string = (arg['url'] as string|null)??''
	if (url == null || url == '') {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: "url参数必填",
			data: null
		} as UTSJSONObject)
		return;
	}

	donwloadIns.create(callbackId, params, (result) => {
		const backData = {
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result
		} as UTSJSONObject
		callback?.(backData)

	}, (error) => {
		const backData = {
			callbackId: callbackId!,
			success: false,
			errorMessage: "下载错误" + error.errCode,
			data: null
		} as UTSJSONObject

		callback?.(backData)
	}, (result) => {
		const backData = {
			callbackId: callbackId!,
			type: 'onUpdate',
			success: true,
			data: result,
			errorMessage: null,
		} as UTSJSONObject
		xWebview!.evaJs(`__handleTmuiResponse('${JSON.stringify(backData)}')`)
	})



}

const _uploadFile = (callbackId ?: string, params ?: UTSJSONObject, xWebview ?: xWebviewU | null, callback ?: uniAppEvaJsTypeCallBackFun) : void => {
	if (callbackId == null) { callback?.(null); return }
	let arg = (params ?? {}) as UTSJSONObject
	const url:string = (arg['url'] as string|null)??''
	const filePath:string|null = (arg['filePath'] as string|null)??null
	const name:string|null = (arg['name'] as string|null)??null
	const header:UTSJSONObject|null = (arg['header'] as UTSJSONObject|null)??null
	const formData:UTSJSONObject|null = (arg['formData'] as UTSJSONObject|null)??null
	const timeout:number = (arg['timeout'] as number|null)??120000
	const filesTemp:UTSJSONObject[] = (arg['filesTemp'] as UTSJSONObject[]|null)??[]
	const file:string = (arg['file'] as string|null)??'file'
	const uri:string = (arg['uri'] as string|null)??''
	let files = filesTemp.map((el : UTSJSONObject) : UploadFileOptionFiles => {
		let a = {
			name: file,
			uri: uri
		} as UploadFileOptionFiles
		return a;
	})
	files = files.filter((el : UploadFileOptionFiles) : boolean => el.uri != '')

	if (filePath == null || url == '' || filePath == '') {
		callback?.({
			callbackId: callbackId!,
			success: false,
			errorMessage: "url或者filePath参数必填",
			data: null
		} as UTSJSONObject)
		return;
	}
	const task = uni.uploadFile({
		url,
		filePath,
		name,
		header,
		formData,
		timeout,
		files,
		success(opts) {
			try {
				let result = typeof opts.data == 'string' && opts.data != '' ? JSON.parseObject(opts.data) : opts.data
				const backData = {
					callbackId: callbackId!,
					success: true,
					errorMessage: null,
					data: { statusCode: opts.statusCode, data: result } as UTSJSONObject
				} as UTSJSONObject
				callback?.(backData)
			} catch (error) {
				const backData = {
					callbackId: callbackId!,
					success: true,
					errorMessage: null,
					data: { statusCode: opts.statusCode, data: opts.data } as UTSJSONObject
				} as UTSJSONObject
				callback?.(backData)
			}
		},
		fail(error) {
			const backData = {
				callbackId: callbackId!,
				success: false,
				errorMessage: "上传错误：" + error.errCode,
				data: null
			} as UTSJSONObject
			callback?.(backData)
		}
	})
	task.onProgressUpdate(result => {
		const backData = {
			callbackId: callbackId!,
			success: true,
			errorMessage: null,
			data: result,
			type: 'onUpdate'
		} as UTSJSONObject
		xWebview!.evaJs(`__handleTmuiResponse('${JSON.stringify(backData)}')`)
	})
}

