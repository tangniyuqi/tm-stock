import { xSSEMethod, xSSEOptions } from "../interface.uts"



export class SSEClientApp {

	private eventSource : EventSource | null = null;

	private abortController : AbortController | null = null;

	private url : string;
	private body:string|ArrayBuffer|UTSJSONObject = ''

	private method : xSSEMethod = "get";

	private postConnected : boolean = false;

	private sseBuffer : string = "";

	private onOpenEvt = () => { }

	private onErrorEvt = () => { }

	private onClosedEvt = () => { }

	private onMessageEvt = (data : string) => { }

	private headers : Map<string, string>

	constructor(options : xSSEOptions) {

		this.url = options.url;

		this.method = options?.method ?? "get";

		let _headers = new Map<string, string>()

		const headersOpts = options?.header ?? ({} as UTSJSONObject)

		for (const key in headersOpts) {

			_headers.set(key, headersOpts.getString(key)!)

		}

		this.headers = _headers

	}



	private usePost() : boolean {

		return this.method == "post"

	}



	private buildFetchHeaders() : UTSJSONObject {

		const reqHeaders = {} as UTSJSONObject

		reqHeaders.set("Accept", "text/event-stream")

		reqHeaders.set("Cache-Control", "no-cache")

		this.headers.forEach((value, key) => {

			reqHeaders.set(key, value)

		})

		return reqHeaders

	}

	private resolveFetchBody() : string | ArrayBuffer | null {

		if (this.body == "") {

			return null

		}

		if (typeof this.body == "string") {

			return this.body as string

		}

		if (this.body instanceof ArrayBuffer) {

			return this.body as ArrayBuffer

		}

		return JSON.stringify(this.body)!

	}



	// EventSource 已由浏览器解析 SSE，event.data 即为 data 字段内容（不含 "data:" 前缀）

	private handleMessage(data : string) {

		if (data === '') {

			return;

		}

		if (data === '[DONE]') {

			this.disconnect();

			return;

		}

		this.onMessageEvt(data);

	}



	private processSseBuffer() : void {

		const separator = "\n\n"

		while (this.sseBuffer.includes(separator)) {

			const idx = this.sseBuffer.indexOf(separator)

			const messageBlock = this.sseBuffer.substring(0, idx)

			this.sseBuffer = this.sseBuffer.substring(idx + separator.length)

			this.parseSseMessageBlock(messageBlock)

		}

	}



	private parseSseMessageBlock(messageBlock : string) : void {

		const lines = messageBlock.split("\n")

		let finalData = ""

		for (let i = 0; i < lines.length; i++) {

			const line = lines[i]

			if (line.length == 0 || line.startsWith(":")) {

				continue

			}

			if (line.startsWith("data: ")) {

				const content = line.substring(6)

				finalData = finalData.length == 0 ? content : finalData + "\n" + content

			} else if (line.startsWith("data:")) {

				const content = line.substring(5)

				finalData = finalData.length == 0 ? content : finalData + "\n" + content

			}

		}

		if (finalData.length > 0) {

			this.handleMessage(finalData)

		}

	}



	private async readPostStream(response : Response) : Promise<void> {

		const body = response.body

		if (body == null) {

			this.onErrorEvt()

			return

		}

		const reader = body.getReader()

		const decoder = new TextDecoder()

		try {

			while (true) {

				const chunk = await reader.read()

				if (chunk.done) {

					break

				}

				this.sseBuffer += decoder.decode(chunk.value, { stream: true })

				this.processSseBuffer()

			}

			this.processSseBuffer()

		} catch (e) {

			const err = e as Error

			if (err.name == "AbortError") {

				return

			}

			console.error("SSE", "读取流失败", e)

			this.onErrorEvt()

			return

		} finally {

			if (this.postConnected) {

				this.postConnected = false

				this.abortController = null

				this.onClosedEvt()

			}

		}

	}



	private connectPost() : void {

		let _this = this

		this.sseBuffer = ""

		this.abortController = new AbortController()

		fetch(this.url, {

			method: "POST",

			headers: this.buildFetchHeaders(),

			signal: this.abortController!.signal,
			body: this.resolveFetchBody()

		}).then((response) => {

			if (!response.ok) {

				_this.postConnected = false

				_this.abortController = null

				_this.onErrorEvt()

				console.error("SSE", "请求失败", response.status)

				return

			}

			_this.postConnected = true

			_this.onOpenEvt()

			_this.readPostStream(response)

		}).catch((e) => {

			const err = e as Error

			if (err.name == "AbortError") {

				return

			}

			_this.postConnected = false

			_this.abortController = null

			console.error("SSE", "发生错误", e)

			_this.onErrorEvt()

		})

	}



	private isBusy() : boolean {

		if (this.usePost()) {

			return this.postConnected || this.abortController != null

		}

		return this.eventSource != null || this.isConnected()

	}


	public setBody(bodyStr:string|ArrayBuffer|UTSJSONObject):void{
		this.body = bodyStr;
	}
	// 打开连接

	public connect() : void {

		if (this.isBusy()) {

			console.error('已有打开的，不允许重复');

			return;

		}

		if (this.usePost()) {

			this.connectPost()

			return

		}

		let _this = this;

		let params = ""

		this.headers.forEach((value, key) => {

			params += `${key}=${value}&`

		})



		if (this.headers.size > 0) {

			params = params.substring(0, params.length - 1)

		}



		let urlParams = this.url;

		if (params.length > 0) {

			urlParams = this.url + "?" + params



		}

		this.eventSource = new EventSource(urlParams);

		this.eventSource.onopen = (event) => {

			_this.onOpenEvt()

		};



		this.eventSource.onerror = (event) => {

			_this.onErrorEvt()

			console.error("SSE", "发生错误", event);

		};

		this.eventSource.onmessage = (event) => {

			_this.handleMessage(event.data)

		};

	}

	onOpen(callback : () => void) {

		this.onOpenEvt = callback

	}

	onError(callback : () => void) {

		this.onErrorEvt = callback

	}

	onClosed(callback : () => void) {

		this.onClosedEvt = callback

	}

	onMessage(callback : (data : string) => void) {

		this.onMessageEvt = callback

	}

	// 关闭连接

	public disconnect() : void {

		if (this.usePost()) {

			if (this.abortController != null) {

				this.abortController!.abort()

				this.abortController = null

			}

			const wasConnected = this.postConnected

			this.postConnected = false

			this.sseBuffer = ""

			if (wasConnected) {

				this.onClosedEvt()

			}

			return

		}

		if (!this.eventSource) {

			return;

		}

		this.eventSource.close();

		this.onClosedEvt()

		this.eventSource = null;

	}



	isConnected() : boolean {

		if (this.usePost()) {

			return this.postConnected

		}

		let status = this.eventSource?.readyState ?? 2

		return status == 1

	}

}

