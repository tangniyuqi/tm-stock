import SSEClient from 'uts.sdk.modules.xSseUtsModule.SSEClient';
import { xSSEMethod, xSSEOptions } from "../interface.uts"

type SSEBodyNative = {
	bodyString : string | null,
	bodyBytes : ByteArray | null,
	contentType : string
}

export class SSEClientApp {
	private sseClient : SSEClient | null = null
	url : string = ''
	private method : xSSEMethod = "get"
	private headers : Map<string, string>
	private body : string | ArrayBuffer | UTSJSONObject = ''
	private closedNotified : boolean = true
	private onOpenEvt = () => { }
	private onErrorEvt = () => { }
	private onClosedEvt = () => { }
	private onMessageEvt = (data : string) => { }

	private httpMethodString() : string {
		return this.method == "post" ? "POST" : "GET"
	}

	/** OkHttp 回调在后台线程，延迟到主线程再触发 Vue 响应式，避免 ConcurrentModificationException */
	private scheduleCallback(fn : () => void) : void {
		setTimeout(fn, 0)
	}

	private notifyClosed() : void {
		if (this.closedNotified) return
		this.closedNotified = true
		this.scheduleCallback(() => {
			this.onClosedEvt()
		})
	}

	private getBodyContentType() : string {
		let contentType : string | null = null
		this.headers.forEach((value, key) => {
			if (key.toLowerCase() == "content-type") {
				contentType = value
			}
		})
		if (contentType != null) {
			return contentType!
		}
		if (typeof this.body == "string") {
			return "text/plain; charset=utf-8"
		}
		if (this.body instanceof ArrayBuffer) {
			return "application/octet-stream"
		}
		return "application/json; charset=utf-8"
	}

	private resolveBodyForNative() : SSEBodyNative {
		const contentType = this.getBodyContentType()
		if (this.body == "") {
			return { bodyString: null, bodyBytes: null, contentType: contentType }
		}
		if (typeof this.body == "string") {
			return { bodyString: this.body as string, bodyBytes: null, contentType: contentType }
		}
		if (this.body instanceof ArrayBuffer) {
			const bb = (this.body as ArrayBuffer).toByteBuffer()
			const bytes = new ByteArray(bb.remaining().toInt())
			bb.get(bytes)
			return { bodyString: null, bodyBytes: bytes, contentType: contentType }
		}
		return {
			bodyString: JSON.stringify(this.body)!,
			bodyBytes: null,
			contentType: "application/json; charset=utf-8"
		}
	}

	constructor(options : xSSEOptions) {
		this.url = options.url;
		this.method = options.method == null ? 'get' : options.method;
		let _headers = new Map<string, string>()
		const headersOpts = options?.header ?? ({} as UTSJSONObject)
		for (const key in headersOpts) {
			_headers.set(key, headersOpts.getString(key)!)
		}
		this.headers = _headers
	}
	@UTSJS.keepAlive
	onOpen(callback : () => void) {
		this.onOpenEvt = callback
	}
	@UTSJS.keepAlive
	onError(callback : () => void) {
		this.onErrorEvt = callback
	}
	@UTSJS.keepAlive
	onClosed(callback : () => void) {
		this.onClosedEvt = callback
	}
	@UTSJS.keepAlive
	onMessage(callback : (data : string) => void) {
		this.onMessageEvt = callback
	}
	public setBody(bodyStr : string | ArrayBuffer | UTSJSONObject) : void {
		this.body = bodyStr;
	}
	connect() {
		if (this.isConnected()) return;
		this.closedNotified = false
		const resolved = this.resolveBodyForNative()
		this.sseClient = SSEClient(
			this.url,
			this.headers,
			this.httpMethodString(),
			resolved.bodyString,
			resolved.bodyBytes,
			resolved.contentType
		)
		let _this = this;
		class sslins implements SSEClient.SSEListener {
			override onOpen() {
				_this.scheduleCallback(() => {
					if (_this.sseClient == null) return
					_this.onOpenEvt()
				})
			}
			override onMessage(event : string | null, data : string) {
				_this.scheduleCallback(() => {
					if (_this.sseClient == null || _this.closedNotified) return
					if (data == "[DONE]") {
						_this.disconnect()
						return
					}
					_this.onMessageEvt(data)
				})
			}
			override onError(throwable : Throwable) {
				_this.scheduleCallback(() => {
					if (_this.closedNotified) return
					console.log("SSE", "发生错误", throwable)
					_this.onErrorEvt()
				})
			}
			override onClosed() {
				_this.scheduleCallback(() => {
					if (_this.closedNotified) return
					_this.sseClient = null
					_this.notifyClosed()
				})
			}
		}
		this.sseClient!.setListener(new sslins())
		this.sseClient!.connect()
	}
	disconnect() {
		if (this.sseClient == null) {
			this.notifyClosed()
			return
		}
		const client = this.sseClient!
		this.sseClient = null
		client.disconnect()
		this.notifyClosed()
	}
	isConnected() : boolean {
		return this.sseClient?.isConnected() ?? false
	}
}
