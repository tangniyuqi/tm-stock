import ViewGroup from 'android.view.ViewGroup';
import Bitmap from 'android.graphics.Bitmap';
import View from 'android.view.View';
import FileOutputStream from 'java.io.FileOutputStream';
import File from 'java.io.File';
import Canvas from 'android.graphics.Canvas';
import Build from 'android.os.Build';
import Handler from 'android.os.Handler';
import Looper from 'android.os.Looper';
import Rect from 'android.graphics.Rect';
import PixelCopy from 'android.view.PixelCopy';
import TextureView from 'android.view.TextureView';
import Color from 'android.graphics.Color';
import { XScreenshotOpts, XScreenshotResult, XScreenshotFormat } from "../interface.uts"
import { XScreenshotImpl } from "../unierror.uts"

function resolveFormat(opts : XScreenshotOpts) : XScreenshotFormat | null {
	let format = opts?.format ?? 'png'
	if (format != 'png' && format != 'jpg') {
		return null
	}
	return format
}

function savePhotoTocache(img : Bitmap, format : XScreenshotFormat) : string {
	let context = UTSAndroid.getAppContext()!
	let filepath = context.getExternalCacheDir()?.getPath() ?? ""
	let fileid = Math.random().toString(16).substring(2, 11);
	let ext = format == 'jpg' ? '.jpg' : '.png'
	let file = new File(filepath, fileid + ext);
	let fos = new FileOutputStream(file)
	if (format == 'jpg') {
		img.compress(Bitmap.CompressFormat.JPEG, 100, fos);
	} else {
		img.compress(Bitmap.CompressFormat.PNG, 100, fos);
	}
	fos.close()
	return file.getPath()
}

/** 递归将 TextureView 画面绘制到 Canvas，修复视频类组件黑屏 */
function overlayVideoViews(view : View, canvas : Canvas) {
	if (view instanceof TextureView) {
		let tv = view as TextureView
		if (tv.isAvailable()) {
			let tvBitmap = tv.getBitmap()
			if (tvBitmap != null) {
				canvas.drawBitmap(tvBitmap, 0.0.toFloat(), 0.0.toFloat(), null)
			}
		}
		return
	}
	if (view instanceof ViewGroup) {
		let vg = view as ViewGroup
		let count = vg.getChildCount()
		for (let i = 0; i < count; i++) {
			let child = vg.getChildAt(i.toInt())
			canvas.save()
			canvas.translate(child.getLeft().toFloat(), child.getTop().toFloat())
			overlayVideoViews(child, canvas)
			canvas.restore()
		}
	}
}

function createShotBitmap(width : Int, height : Int, format : XScreenshotFormat) : Bitmap {
	let bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
	if (format == 'png') {
		bitmap.eraseColor(0)
	} else {
		bitmap.eraseColor(Color.WHITE)
	}
	return bitmap
}

/**
 * 节点 PNG：仅绘制目标 View，保留透明通道（不合成窗口/父级背景）
 * 临时清除 target 自身 background，避免 uni 容器自带白底污染 PNG 透明通道；
 * 子节点的 background 仍按其自身绘制。
 */
function shotElementTransparentCanvas(target : View, format : XScreenshotFormat) : string | null {
	if (target.width <= 0 || target.height <= 0) {
		return null
	}
	let bitmap = createShotBitmap(target.width, target.height, 'png')
	let canvas = new Canvas(bitmap)
	let savedBg = target.getBackground()
	if (savedBg != null) {
		target.setBackground(null)
	}
	try {
		target.draw(canvas)
	} finally {
		if (savedBg != null) {
			target.setBackground(savedBg)
		}
	}
	overlayVideoViews(target, canvas)
	return savePhotoTocache(bitmap, format)
}

/**
 * 从根节点按窗口坐标绘制，保留父级背景色（适用于窗口截图、节点 jpg）
 */
function shotViewWithCanvas(target : View, format : XScreenshotFormat) : string | null {
	if (target.width <= 0 || target.height <= 0) {
		return null
	}
	let bitmap = createShotBitmap(target.width, target.height, format)
	let canvas = new Canvas(bitmap)
	let location = new IntArray(2)
	target.getLocationInWindow(location)
	canvas.save()
	canvas.translate(-location[0].toFloat(), -location[1].toFloat())
	canvas.clipRect(0, 0, target.width, target.height)
	let rootview = target.getRootView()
	rootview.draw(canvas)
	overlayVideoViews(rootview, canvas)
	canvas.restore()
	return savePhotoTocache(bitmap, format);
}

function shotViewWithPixelCopy(view : View, format : XScreenshotFormat, onDone : (path : string | null) => void) {
	let activity = UTSAndroid.getUniActivity()
	if (activity == null) {
		onDone(shotViewWithCanvas(view, format))
		return
	}
	let width = view.width
	let height = view.height
	if (width <= 0 || height <= 0) {
		onDone(null)
		return
	}
	let bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
	let location = new IntArray(2)
	view.getLocationInWindow(location)
	let rect = new Rect(
		location[0],
		location[1],
		location[0] + width,
		location[1] + height
	)
	let handler = new Handler(Looper.getMainLooper())
	class pixelCopty extends PixelCopy.OnPixelCopyFinishedListener{
		override onPixelCopyFinished(copyResult : Int) {
			if (copyResult == PixelCopy.SUCCESS) {
				onDone(savePhotoTocache(bitmap, format))
			} else {
				onDone(shotViewWithCanvas(view, format))
			}
		}
	}
	PixelCopy.request(activity.window, rect, bitmap, new pixelCopty(), handler)
}

function shotViewToPathAsync(view : View, format : XScreenshotFormat, onDone : (path : string | null) => void) {
	if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
		shotViewWithPixelCopy(view, format, onDone)
	} else {
		onDone(shotViewWithCanvas(view, format))
	}
}

/** 节点截图：png 透明底仅画自身；jpg 走 PixelCopy/根节点合成 */
function shotElementToPathAsync(target : View, format : XScreenshotFormat, onDone : (path : string | null) => void) {
	if (format == 'png') {
		onDone(shotElementTransparentCanvas(target, format))
		return
	}
	shotViewToPathAsync(target, format, onDone)
}

function callbackSuccess(opts : XScreenshotOpts, path : string) {
	const resultJg : XScreenshotResult = {
		path: path
	}
	opts?.success?.(resultJg)
	opts?.complete?.(resultJg)
}

function callbackFail(opts : XScreenshotOpts, errCode : number) {
	opts?.fail?.(new XScreenshotImpl(errCode))
	opts?.complete?.(null)
}

/**
 * 获取窗口截图
 */
export function getRootShotImage(opts : XScreenshotOpts) {
	let format = resolveFormat(opts)
	if (format == null) {
		callbackFail(opts, 1007)
		return
	}
	try {
		let decorView : ViewGroup = UTSAndroid.getUniActivity()!.window.decorView as ViewGroup
		let rootview : View = decorView.getRootView()
		shotViewToPathAsync(rootview, format, (path : string | null) => {
			if (path == null || path == '') {
				callbackFail(opts, 1001)
				return
			}
			callbackSuccess(opts, path)
		})
	} catch (e) {
		console.error("X-Screenshot Error:", e)
		callbackFail(opts, 1002)
	}
}

/**
 * 获取指定元素截图
 */
export function getElementShotImage(opts : XScreenshotOpts) {
	let format = resolveFormat(opts)
	if (format == null) {
		callbackFail(opts, 1007)
		return
	}
	let ele = opts.ele
	if (ele == null) {
		callbackFail(opts, 1003)
		return;
	}
	try {
		let view = ele.getAndroidView() as View | null;
		if (view == null) {
			callbackFail(opts, 1003)
			return;
		}
		if (view.width <= 0 || view.height <= 0) {
			callbackFail(opts, 1004)
			return
		}
		shotElementToPathAsync(view, format, (path : string | null) => {
			if (path == null || path == '') {
				callbackFail(opts, 1001)
				return
			}
			callbackSuccess(opts, path)
		})
	} catch (e) {
		console.error("X-Screenshot Error:", e)
		callbackFail(opts, 1002)
	}
}
