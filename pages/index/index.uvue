<template>
<view class="page">
  <z-paging-x
    ref="pagingX"
    v-model="newsList"
    :default-page-size="pageSize"
    :paging-style="pagingStyle"
    :list-is="listType"
    empty-text="当日暂无题材动态"
    refresher-default-text="下拉刷新"
    refresher-pulling-text="松开立即刷新"
    refresher-refreshing-text="正在刷新…"
    refresher-complete-text="刷新完成"
    refresher-background="#F5F5F5"
    @query="queryList"
  >
    <!-- 顶部固定：标签页 + 日期切换 -->
    <template #top>
      <x-sticky>
        <view class="my-tabs px-6 pt-4 pb-2">
          <x-tabs :list="tabList" v-model="activeTab" color="#FFF" :line-full="false" activeFontSize="18" :line-width="28" :line-color="xConfig.color" titleColor="#333" @change="handleTabChange" />
        </view>
      </x-sticky>

      <!-- 日期切换 -->
      <view class="flex flex-row align-center justify-between px-25 py-12 bg-white date-switcher">
        <x-text :color="isPrevDisabled ? '#CCC' : '#666'" fontSize="14" @click="prevDay">上一日</x-text>

        <view class="flex-1"></view>

        <view class="flex flex-row align-center flex-row-center-between" @click="showCalendar = true">
          <x-icon name="calendar-line" size="14" color="#999" />
          <x-text color="#666" fontSize="15" class="font-weight-b ml-4">{{ currentDate }}</x-text>
        </view>

        <view class="flex-1"></view>

        <x-text :color="isNextDisabled ? '#CCC' : '#666'" fontSize="14" @click="nextDay">下一日</x-text>
      </view>
    </template>

    <x-sheet :margin="[12, 0, 12, 16]" :padding="[0, 12, 0, 12]">
      <!-- 首次加载骨架屏（模拟题材动态列表项布局，x-sheet 白底包裹） -->
      <view v-if="showSkeleton" class="skeleton-block">
        <view v-for="n in 7" :key="n" class="news-item-wrapper px-18 py-12">
          <view class="flex flex-row align-start">
            <x-skeleton width="20" height="20" round="4" class="mt-6 mr-12" />

            <view class="flex-1">
              <x-skeleton height="20" round="4" />

              <view class="flex flex-row align-center mt-10">
                <x-skeleton width="70" height="20" round="6" class="mr-10" />
                <x-skeleton width="45" height="16" round="6" class="mt-2" />
                <view class="flex-1"></view>
                <x-skeleton width="70" height="20" round="6" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 列表项 -->
      <view v-for="(item, index) in newsList" class="news-item-wrapper px-12 py-12" @click="goDetail(item)" :key="item.id">
        <view class="flex flex-row align-start">
          <x-text :color="getIndexColor(index)" fontSize="24" class="mr-12 news-index">{{ index + 1 }}</x-text>

          <view class="flex-1">
            <x-text color="#333" fontSize="15" lineHeight="1.5" class="flex-1 text-base text-black font-weight-b text-overflow-2">{{ item.title }}</x-text>

            <view class="flex flex-row align-center mt-10">
              <view class="flex flex-row flex-row-center-start">
                <x-tag skin="thin" color="primary" class="mr-10">{{ item.tag }}</x-tag>
                <x-text :color="getChangeColor(item.change)" fontSize="13" class="font-weight-b">{{ item.change }}</x-text>
              </view>

              <view class="flex-1"></view>

              <x-text color="#999" fontSize="13" class="ml-10">{{ item.datetime }}</x-text>
            </view>
          </view>
        </view>
      </view>
    </x-sheet>

    <!-- 上拉加载提示 -->
    <template #loadMore="slotProps">
      <view class="load-more-bar pb-24 flex-row flex-center">
        <x-loading
          v-if="slotProps.loadMoreStatus == 'loading'"
          color="#999"
          textSize="14"
          :vertical="false"
          label="正在加载更多…"
        />
        <x-text
          v-else
          :label="loadMoreText(slotProps.loadMoreStatus)"
          color="#999"
          fontSize="14"
        />
      </view>
    </template>

    <!-- Footer：固定在页面最底部（#bottom 位于滚动列表之外，不随列表滚动） -->
    <!-- <template #bottom>
      <view class="footer py-20 flex-center">
        <x-text fontSize="12" color="#CCC">题材助手 · 洞察市场主线</x-text>
        <x-text fontSize="12" color="#DDD" class="mt-6">所有数据仅供参考，不作收益保证，据此操作风险自负。</x-text>
        <x-text fontSize="12" color="#DDD">— 投资有风险，入市须谨慎 —</x-text>
      </view>
    </template> -->
  </z-paging-x>

  <!-- 日历弹窗 -->
  <x-drawer v-model:show="showCalendar" title="选择日期" :showFooter="false" size="540" round="24">
    <view class="calendar-drawer-content">
      <x-calendar-view
        v-model="currentDate"
        :startDate="minDateStr"
        :endDate="maxDateStr"
        :showClear="false"
        activeFontColor="#FFFFFF"
        headBgColor="#F7F8FA"
        headFontColor="#333333"
        headStyle="border-radius: 12px; padding: 4px 0;"
        @change="onCalendarChange"
      ></x-calendar-view>
    </view>
  </x-drawer>
</view>
</template>

<script setup lang="ts">
import { ref, computed } from 'vue';
import { xConfig } from '@/uni_modules/tmx-ui/config/xConfig.uts';
import { xDate } from '@/uni_modules/tmx-ui/core/util/xDate.uts';
import { api } from '@/api/quant/themeTopic.uts';
import { ThemeHotItem } from '@/types/interface.uts';

// 标签页数据
const tabList = ref([
  { id: 2, title: '题材动态' },
  { id: 3, title: '题材轮动' },
  { id: 4, title: '题材库' }
]);

const activeTab = ref('2');

// 日期限制
const minDateStr = '2026-07-21';
const maxDateStr = new xDate().format("YYYY-MM-DD");

// 当前选中的日期
const currentDate = ref(maxDateStr);
const showCalendar = ref(false);

// 是否禁用上一日/下一日
const isPrevDisabled = computed(() : boolean => currentDate.value <= minDateStr);
const isNextDisabled = computed(() : boolean => currentDate.value >= maxDateStr);

// 滚动容器类型: H5 / 微信使用 scroll-view(兼容触底加载), 其余原生端使用 list-view(长列表性能更优)
let listType = 'list-view' as string;
// #ifdef H5 || MP-WEIXIN
listType = 'scroll-view' as string;
// #endif

// 题材动态列表（真实数据，由 z-paging-x 通过 v-model 维护，支持下拉刷新与上拉加载）
const newsList = ref<ThemeHotItem[]>([]);

// 首次加载骨架屏（仅首次加载期间显示，加载完成后隐藏）
const showSkeleton = ref(true);

const pageSize = 20;

// z-paging-x 根节点样式（白底）
const pagingStyle = ref<object>({
  // backgroundColor: '#FFF'
});

// z-paging-x 组件实例
const pagingX = ref<ZPagingXComponentPublicInstance | null>(null);

// 刷新列表（回到第一页重新拉取）
const reloadData = () => {
  pagingX.value?.reload();
};

const goDetail = (item: ThemeHotItem) => {
  uni.navigateTo({
    url: '/pages/theme_topic/detail?id=' + item.id
  });
};

const getIndexColor = (index: number): string => {
  if (index == 0) return '#FF4D4F'; // 1st - Red
  if (index == 1) return '#FA8C16'; // 2nd - Orange
  if (index == 2) return '#FADB14'; // 3rd - Yellow
  return '#BBB'; // Others - Grey
};

const getChangeColor = (change: string): string => {
  if (change.startsWith('+')) return '#FF4D4F';
  if (change.startsWith('-')) return '#52C41A';
  return '#999';
};

const handleTabChange = (item: any, index: number) => {
  switch(item.id) {
    case '2':
      // 题材动态
      reloadData();
      break;
  }
};

// 上拉加载提示文案（loadMoreStatus 由 z-paging-x 传入）
const loadMoreText = (status: string): string => {
  switch (status) {
    case 'loading':
      return '正在加载更多…';
    case 'no-more':
      return '没有更多动态了';
    case 'fail':
      return '加载失败，上拉重试';
    default:
      return '上拉加载更多';
  }
};

// 日期操作
const prevDay = () => {
  if (isPrevDisabled.value) return;
  const d = new xDate(currentDate.value);
  d.subtraction(1, 'd');
  currentDate.value = d.format("YYYY-MM-DD");
  showSkeleton.value = true;
  reloadData();
};

const nextDay = () => {
  if (isNextDisabled.value) return;
  const d = new xDate(currentDate.value);
  d.add(1, 'd');
  currentDate.value = d.format("YYYY-MM-DD");
  showSkeleton.value = true;
  reloadData();
};

const onCalendarChange = (val: string) => {
  if (!val) return;
  currentDate.value = val;
  showCalendar.value = false;
  showSkeleton.value = true;
  reloadData();
};

// @query 由 z-paging-x 自动触发（首次加载/下拉刷新/上拉加载）
// pageNo 与 pageSize 已由组件自动计算，无需自行维护页码
const queryList = (pageNo: number, pageSize: number, from: string) => {
  api
    .getThemeTopicList({ publish_date: currentDate.value, page: pageNo, pageSize: pageSize } as UTSJSONObject)
    .then((result) => {
      // 首次加载完成后隐藏骨架屏（下拉刷新/上拉加载不再显示）
      if (showSkeleton.value) {
        showSkeleton.value = false;
      }
      const px = pagingX.value;
      if (result == null) {
        px?.complete([]);
        return;
      }
      // completeByTotal 根据 total 判断是否还有更多数据
      px?.completeByTotal(result.list, result.total);
    });
};
</script>

<style scoped>
.page {
  padding: 0 0 0 0;
  display: flex;
  flex-direction: column;
  /* 关键：z-paging-x 的滚动容器依赖父级有确定高度才能撑满视口并触发触底加载 */
  height: 100vh;
}

.my-tabs {
  background: #FFF;
}

.date-switcher {
  border-bottom: 1px solid #f5f5f5;
}

.calendar-drawer-content {
  padding: 10px 15px 30px 15px;
}

.news-item-wrapper {
  border-bottom: 1px solid #f0f0f0;
}

.news-item-wrapper:last-child {
  border-bottom: none;
}

.news-index {
  font-family: Georgia, "Times New Roman", Times, serif;;
  font-style: italic;
  font-weight: bold;
}

.load-more-bar {
  text-align: center;
}

.text-overflow-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}
</style>
