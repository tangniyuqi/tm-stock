<style lang="scss">
// 表格红色边框样式
:deep(.xTable) {
  border: 1px solid red;
}

:deep(.xTabelHoz) {
  border-bottom: 1px solid red;
}

:deep(.xTabelHozItemContent),
:deep(.xTabelHozItem) {
  border-right: 1px solid red;
}

:deep(.xTabelHozItemContent:last-child),
:deep(.xTabelHozItem:last-child) {
