const isUnsafeUrlCharacter = (character : string) : boolean => {
	return character == ' ' || character == '\t' || character == '\n' || character == '\r'
		|| character == '\\' || character == '"' || character == "'" || character == '<' || character == '>'
}

const getSafeExternalHost = (url : string) : string => {
	let endIndex = url.length
	for (let index = 8; index < url.length; index++) {
		const character = url.charAt(index)
		if (character == '/' || character == '?' || character == '#') {
			endIndex = index
			break
		}
	}
	return url.substring(8, endIndex)
}

export const isSafeExternalUrl = (url : string) : boolean => {
	if (url.length <= 8 || url != url.trim() || url.indexOf('https://') != 0) {
		return false
	}
	for (let index = 0; index < url.length; index++) {
		if (isUnsafeUrlCharacter(url.charAt(index))) {
			return false
		}
	}
	const host = getSafeExternalHost(url)
	return host.length > 0 && host.indexOf('@') < 0
}

export const copySafeExternalUrl = (url : string) : void => {
	if (!isSafeExternalUrl(url)) {
		uni.showToast({ title: '原文链接暂不可用', icon: 'none' })
		return
	}
	uni.setClipboardData({
		data: url,
		success: () => {
			uni.showToast({ title: '原文链接已复制', icon: 'none' })
		}
	})
}

const openApprovedExternalUrl = (url : string) : void => {
	// #ifdef WEB
	const targetWindow = window.open(url, '_blank')
	if (targetWindow != null) {
		targetWindow.opener = null
		return
	}
	// #endif
	copySafeExternalUrl(url)
}

export const openSafeExternalUrl = (url : string) : void => {
	if (!isSafeExternalUrl(url)) {
		uni.showToast({ title: '原文链接暂不可用', icon: 'none' })
		return
	}
	const host = getSafeExternalHost(url)
	uni.showModal({
		title: '打开原文链接',
		content: '即将前往 ' + host + ' 查看原文，请确认链接来源。',
		confirmText: '继续打开',
		cancelText: '取消',
		success: (result) => {
			if (result.confirm == true) {
				openApprovedExternalUrl(url)
			}
		}
	})
}
