// 会话内技能目录：只描述已实现/未开放的客户端能力，服务端仍有独立开关与准入。
export type AISkill = {
	key : string,
	title : string,
	summary : string,
	scope : string,
	price : string,
	state : string,
	reason : string
}

const catalog : AISkill[] = [
	{
		key: 'material_qa',
		title: '资料问答',
		summary: '在所选授权资料内查找事实引文，无证据固定拒答。',
		scope: '当前所选题材的授权资料',
		price: '不扣积分',
		state: 'available',
		reason: ''
	},
	{
		key: 'light',
		title: '轻度资料整理',
		summary: '按题材整理公开资料并生成四节报告，需复核报价后创建。',
		scope: '当前会话所选题材',
		price: '需报价确认',
		state: 'quote',
		reason: ''
	},
	{
		key: 'deep',
		title: '深度资料整理',
		summary: '多 Agent 深度整理：四节报告、至少六条逐字引文。',
		scope: '会话内当前所选题材',
		price: '30积分/次',
		state: 'quote',
		reason: '需先按题材核对 30 积分报价，确认后冻结；失败/取消/超时全额释放。'
	},
	{
		key: 'report_qa',
		title: '报告追问',
		summary: '针对本人当前可读报告的有出处追问。',
		scope: '会话内本人当前可读报告',
		price: '不扣积分',
		state: 'unavailable',
		reason: '请在会话内打开本人可读报告后，从报告下方发起追问。'
	}
]

export const aiSkills = () : AISkill[] => catalog
export const isAISkillKey = (key : string) : boolean => {
	for (const item of catalog) { if (item.key == key) return true }
	return false
}
export const aiSkillByKey = (key : string) : AISkill | null => {
	for (const item of catalog) { if (item.key == key) return item }
	return null
}
export const isAISkillUsable = (skill : AISkill | null) : boolean => skill != null && (skill!.state == 'available' || skill!.state == 'quote')
export const aiSkillStateLabel = (state : string) : string => {
	if (state == 'available') return '可用'
	if (state == 'quote') return '需报价'
	return '暂不可用'
}