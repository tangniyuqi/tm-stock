import { isSafeAIId, isSafeAIInteger } from './ai.uts'
import { MemberApi, MemberApiResult } from './member-api.uts'

export type AIReportInputFact = { id : string, text : string }
export type AIReportInputCall = { seq : number, node : string, model : string, state : string, requestDigest : string, promptDigest : string, inputTokens : number, outputTokens : number, costMicros : number | null }
export type AIReportInputs = { taskId : number, subjectId : number, schema : string, scope : string, upstreamCommit : string, provider : string, fixtureDigest : string, fixtureSubject : string, fixtureNotice : string, facts : AIReportInputFact[], calls : AIReportInputCall[] }
const keys = (names : string[], expected : string[]) : boolean => names.length == expected.length && names.every((name : string) : boolean => expected.includes(name))
const digest = (v : string) : boolean => typeof v == 'string' && /^[a-f0-9]{64}$/.test(v)
const nodes : string[] = ['bear_researcher_v2','bull_researcher_v2','fundamentals_analyst_v2','index_analyst_v2','market_analyst_v2','neutral_analyst_v2','news_analyst_v2','research_manager_v2','risk_manager_v2','risky_analyst_v2','safe_analyst_v2','sector_analyst_v2','social_analyst_v2','trader_v2']
export const isAIReportInputs = (v : AIReportInputs | null, taskId : number, subjectId : number) : boolean => {
	if (v == null || typeof v != 'object' || Array.isArray(v) || !keys(Object.keys(v),['taskId','subjectId','schema','scope','upstreamCommit','provider','fixtureDigest','fixtureSubject','fixtureNotice','facts','calls']) || !isSafeAIId(v.taskId) || !isSafeAIId(v.subjectId) || v.taskId != taskId || v.subjectId != subjectId || typeof v.schema != 'string' || v.schema != 'tm-stock-agent-inputs-v1' || typeof v.scope != 'string' || v.scope != 'synthetic-fixture-only' || typeof v.upstreamCommit != 'string' || v.upstreamCommit != '51060a7682cf51810b4bc3a704829438d18cd8dc' || !['deepseek','qwen-token-plan'].includes(v.provider) || !digest(v.fixtureDigest) || typeof v.fixtureSubject != 'string' || v.fixtureSubject != 'TMEVAL（集成测试主体，非真实证券）' || typeof v.fixtureNotice != 'string' || v.fixtureNotice != '仅用于接线测试，无真实行情、财报、新闻或投资用途。不得编造缺失数字。' || !Array.isArray(v.facts) || v.facts.length != 1 || !Array.isArray(v.calls) || v.calls.length < 14 || v.calls.length > 128) return false
	const fact = v.facts[0]
	if (fact == null || typeof fact != 'object' || !keys(Object.keys(fact),['id','text']) || typeof fact.id != 'string' || fact.id != 'fixture-1' || typeof fact.text != 'string' || fact.text != '测试设备用于处理样例数据。') return false
	let seq : number = 0
	let seen : string[] = [] as string[]
	for (const call of v.calls) {
		seq++
		if (call == null || typeof call != 'object' || Array.isArray(call) || !keys(Object.keys(call),['seq','node','model','state','requestDigest','promptDigest','inputTokens','outputTokens','costMicros']) || !isSafeAIId(call.seq) || call.seq != seq || typeof call.node != 'string' || (!nodes.includes(call.node) && call.node != 'chip_distribution_analyst_v2') || typeof call.model != 'string' || call.model != (v.provider == 'deepseek' ? 'deepseek-flash' : 'qwen3.7-plus') || typeof call.state != 'string' || call.state != 'confirmed' || !digest(call.requestDigest) || !digest(call.promptDigest) || !isSafeAIInteger(call.inputTokens) || !isSafeAIInteger(call.outputTokens) || call.costMicros !== null) return false
		if (!seen.includes(call.node)) seen.push(call.node)
	}
	return nodes.every((node : string) : boolean => seen.includes(node))
}
export const readAIReportInputs = async (taskId : number, subjectId : number) : Promise<MemberApiResult<AIReportInputs>> => {
	if (!isSafeAIId(taskId) || !isSafeAIId(subjectId)) return {code:40001,message:'记录编号无效',data:null} as MemberApiResult<AIReportInputs>
	const r = await MemberApi.aiRead<AIReportInputs>('/api/v1/ai/tasks/'+taskId.toString()+'/report/inputs')
	if (r.code == 0 && !isAIReportInputs(r.data,taskId,subjectId)) return {code:50001,message:'记录格式未通过核验',data:null} as MemberApiResult<AIReportInputs>
	return r
}
