import { LoginResponse, MemberProfile, RedeemResponse } from './member.uts'
import { currentAIMemberToken } from './ai-session.uts'

// C 端会员请求只走同源内部接口；各服务是否开放仍由服务器独立门禁决定。
const apiOrigin = ''

type MemberApiEnvelope<T> = {
	code : number,
	msg : string,
	data : T | null
}

type MemberApiPayload = UTSJSONObject | string
type MemberRequestMethod = 'GET' | 'POST' | 'PATCH'

export type MemberApiResult<T> = {
	code : number,
	message : string,
	data : T | null
}

const failure = <T>(code : number, message : string) : MemberApiResult<T> => {
	return {
		code: code,
		message: message,
		data: null
	} as MemberApiResult<T>
}

const parseResult = <T>(data : MemberApiPayload | null, statusCode : number) : MemberApiResult<T> => {
	if (data == null) {
		return failure<T>(50001, '服务暂不可用，请稍后重试')
	}
	try {
		const responseText = (typeof data == 'string' ? data : JSON.stringify(data)).trim()
		if (responseText.length == 0 || responseText.charAt(0) != '{') {
			return failure<T>(50001, '服务暂不可用，请稍后重试')
		}
		const envelope = JSON.parse<MemberApiEnvelope<T> | null>(responseText)
		if (envelope == null || typeof envelope.code != 'number' || typeof envelope.msg != 'string') {
			return failure<T>(50001, '服务暂不可用，请稍后重试')
		}
		if (statusCode < 200 || statusCode >= 300) {
			if (envelope.code != 0) {
				return failure<T>(envelope.code, envelope.msg.length > 0 ? envelope.msg : '请求失败，请稍后重试')
			}
			if (statusCode == 401) {
				return failure<T>(40100, '登录状态已失效，请重新登录')
			}
			if (statusCode == 403) {
				return failure<T>(40301, '当前账号无权访问该服务')
			}
			return failure<T>(50001, '服务暂不可用，请稍后重试')
		}
		if (envelope.code != 0) {
			return failure<T>(envelope.code, envelope.msg.length > 0 ? envelope.msg : '请求失败，请稍后重试')
		}
		return {
			code: 0,
			message: '',
			data: envelope.data
		} as MemberApiResult<T>
	} catch (_) {
		return failure<T>(50001, '服务暂不可用，请稍后重试')
	}
}

const requestHeaders = (method : MemberRequestMethod, authenticated : boolean, token : string) : UTSJSONObject => {
	const shouldAttachAuth = authenticated && token != null && typeof token == 'string' && token.length > 0
	if (shouldAttachAuth && method != 'GET') {
		return {
			Authorization: 'Bearer ' + token,
			'Content-Type': 'application/json'
		} as UTSJSONObject
	}
	if (shouldAttachAuth) {
		return {
			Authorization: 'Bearer ' + token
		} as UTSJSONObject
	}
	if (method != 'GET') {
		return {
			'Content-Type': 'application/json'
		} as UTSJSONObject
	}
	return {} as UTSJSONObject
}

function requestWithToken<T>(path : string, method : MemberRequestMethod, data : UTSJSONObject, authenticated : boolean, token : string, key : string = '', timeoutMS : number = 10000) : Promise<MemberApiResult<T>> {
	return new Promise<MemberApiResult<T>>((resolve) => {
		let headers : UTSJSONObject = requestHeaders(method, authenticated, token)
		if (key.length > 0) {
			headers = method == 'POST' ? { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json', 'Idempotency-Key': key } as UTSJSONObject
				: { Authorization: 'Bearer ' + token, 'Idempotency-Key': key } as UTSJSONObject
		}
		uni.request<MemberApiPayload>({
			url: apiOrigin + path,
			method: method,
			data: data,
			header: headers,
			dataType: 'text',
			responseType: 'text',
			timeout: timeoutMS,
			success: (res : RequestSuccess<MemberApiPayload>) => {
				resolve(parseResult<T>(res.data, res.statusCode))
			},
			fail: () => {
				resolve(failure<T>(50001, '网络连接失败，请稍后重试'))
			}
		})
	})
}

const requestApi = <T>(path : string, method : MemberRequestMethod, data : UTSJSONObject, authenticated : boolean) : Promise<MemberApiResult<T>> => {
	const token = uni.getStorageSync('tm_member_token')
	return requestWithToken<T>(path, method, data, authenticated, typeof token == 'string' ? token : '')
}

export class MemberApi {
	// 问答只开放四个固定端点；仅提交使用28秒，其余与既有接口保持10秒。
	public static aiQuestion<T>(operation : string, cid : number, seq : number, body : UTSJSONObject, key : string) : Promise<MemberApiResult<T>> {
		if (typeof cid != 'number' || cid <= 0 || cid > 9007199254740991 || Math.floor(cid) != cid || typeof seq != 'number' || seq < 0 || seq > 9007199254740991 || Math.floor(seq) != seq) return Promise.resolve(failure<T>(40001,'问题编号无效'))
		const base : string = '/api/v1/ai/conversations/'+cid.toString()
		if (operation == 'submit' || operation == 'receipt') {
			if (seq != 0 || !/^[A-Za-z0-9_-]{16,80}$/.test(key)) return Promise.resolve(failure<T>(40001,'原问题键无效'))
			return requestWithToken<T>(base+(operation == 'submit' ? '/questions' : '/question-receipt'),operation == 'submit' ? 'POST' : 'GET',operation == 'submit' ? body : {} as UTSJSONObject,true,currentAIMemberToken(),key,operation == 'submit' ? 28000 : 10000)
		}
		if (seq <= 0 || key != '' || operation != 'status' && operation != 'answer') return Promise.resolve(failure<T>(40001,'问答操作无效'))
		return requestWithToken<T>(base+'/questions/'+seq.toString()+(operation == 'answer' ? '/answer' : ''),'GET',{} as UTSJSONObject,true,currentAIMemberToken())
	}
	// 会话任务固定门面，不开放原任务键、金额、模型参数或任意URL。
	public static aiConversationTask<T>(operation : string, cid : number, id : number, before : number, body : UTSJSONObject, key : string) : Promise<MemberApiResult<T>> {
		if (typeof cid != 'number' || cid <= 0 || cid > 9007199254740991 || Math.floor(cid) != cid || typeof id != 'number' || id < 0 || id > 9007199254740991 || Math.floor(id) != id || typeof before != 'number' || before < 0 || before > 9007199254740991 || Math.floor(before) != before) return Promise.resolve(failure<T>(40001, '意图参数无效'))
		const base : string = '/api/v1/ai/conversations/' + cid.toString()
		if (operation == 'list' && id == 0 && key == '') return requestWithToken<T>(base + '/task-intents?limit=20' + (before > 0 ? '&before_id=' + before.toString() : ''), 'GET', {} as UTSJSONObject, true, currentAIMemberToken())
		if (operation == 'prepare' || operation == 'receipt') {
			if (id != 0 || !/^[A-Za-z0-9_-]{16,80}$/.test(key)) return Promise.resolve(failure<T>(40001, '意图原键无效'))
			return requestWithToken<T>(base + (operation == 'prepare' ? '/task-intents' : '/task-intent-receipt'), operation == 'prepare' ? 'POST' : 'GET', operation == 'prepare' ? body : {} as UTSJSONObject, true, currentAIMemberToken(), key)
		}
		if (id <= 0 || key != '') return Promise.resolve(failure<T>(40001, '意图参数无效'))
		const path : string = base + '/task-intents/' + id.toString()
		if (operation == 'detail') return requestWithToken<T>(path, 'GET', {} as UTSJSONObject, true, currentAIMemberToken())
		if (operation == 'confirm') return requestWithToken<T>(path + '/confirm', 'POST', {confirmed: true} as UTSJSONObject, true, currentAIMemberToken())
		if (operation == 'reconcile') return requestWithToken<T>(path + '/reconcile', 'POST', {} as UTSJSONObject, true, currentAIMemberToken())
		return Promise.resolve(failure<T>(40001, '意图操作无效'))
	}
	// 会话元数据闭集；不接受外部URL、消息写入、模型或收费任务操作。
	public static aiConversation<T>(operation : string, id : number, cursor : number, archived : boolean, body : UTSJSONObject, key : string) : Promise<MemberApiResult<T>> {
		if (typeof id != 'number' || id < 0 || id > 9007199254740991 || Math.floor(id) != id || typeof cursor != 'number' || cursor < 0 || cursor > 9007199254740991 || Math.floor(cursor) != cursor) return Promise.resolve(failure<T>(40001, '会话参数无效'))
		const base : string = '/api/v1/ai/conversations'
		if (operation == 'list' && id == 0 && key == '') return requestWithToken<T>(base + '?limit=20&archived=' + (archived ? '1' : '0') + (cursor > 0 ? '&before_id=' + cursor.toString() : ''), 'GET', {} as UTSJSONObject, true, currentAIMemberToken())
		if (operation == 'create' || operation == 'receipt') {
			if (!/^[A-Za-z0-9_-]{16,80}$/.test(key)) return Promise.resolve(failure<T>(40001, '会话原键无效'))
			return requestWithToken<T>(operation == 'create' ? base : '/api/v1/ai/conversation-receipt', operation == 'create' ? 'POST' : 'GET', operation == 'create' ? body : {} as UTSJSONObject, true, currentAIMemberToken(), key)
		}
		if (id <= 0 || key != '') return Promise.resolve(failure<T>(40001, '会话参数无效'))
		const path : string = base + '/' + id.toString()
		if (operation == 'detail') return requestWithToken<T>(path, 'GET', {} as UTSJSONObject, true, currentAIMemberToken())
		if (operation == 'messages') return requestWithToken<T>(path + '/messages?limit=20&after_seq=' + cursor.toString(), 'GET', {} as UTSJSONObject, true, currentAIMemberToken())
		if (operation == 'rename') return requestWithToken<T>(path, 'PATCH', body, true, currentAIMemberToken())
		if (operation == 'archive') return requestWithToken<T>(path + '/archive', 'POST', body, true, currentAIMemberToken())
		return Promise.resolve(failure<T>(40001, '会话操作无效'))
	}
	// 固定反馈契约；空分类为查询，非空仅提交闭集分类，不接受正文或内部处理参数。
	public static aiFeedback<T>(id : number, category : string) : Promise<MemberApiResult<T>> {
		if (typeof id != 'number' || id <= 0 || id > 9007199254740991 || Math.floor(id) != id || typeof category != 'string'
			|| (category != '' && !['fact', 'source', 'display', 'other'].includes(category))) return Promise.resolve(failure<T>(40001, '反馈参数无效'))
		return requestWithToken<T>('/api/v1/ai/tasks/' + id.toString() + '/feedback', category == '' ? 'GET' : 'POST', category == '' ? {} as UTSJSONObject : { category: category } as UTSJSONObject, true, currentAIMemberToken())
	}
	// 独立固定取消契约，不接受任意地址、会员编号、金额或请求正文。
	public static aiCancel<T>(id : number) : Promise<MemberApiResult<T>> {
		if (typeof id != 'number' || id <= 0 || id > 9007199254740991 || Math.floor(id) != id) return Promise.resolve(failure<T>(40001, '任务编号无效'))
		return requestWithToken<T>('/api/v1/ai/tasks/' + id.toString() + '/cancel', 'POST', {} as UTSJSONObject, true, currentAIMemberToken())
	}
	// 只开放固定内部契约；创建键只在请求头，不进入URL或日志，不自动重试。
	public static aiSubmission<T>(operation : string, data : UTSJSONObject, key : string) : Promise<MemberApiResult<T>> {
		if (operation == 'quote' && key == '') return requestWithToken<T>('/api/v1/ai/tasks/quote', 'POST', data, true, currentAIMemberToken())
		if (key != key.trim() || !/^[A-Za-z0-9_-]{16,80}$/.test(key)) return Promise.resolve(failure<T>(40001, '请求参数无效'))
		if (operation == 'create') return requestWithToken<T>('/api/v1/ai/tasks', 'POST', data, true, currentAIMemberToken(), key)
		if (operation == 'receipt') return requestWithToken<T>('/api/v1/ai/task-receipt', 'GET', {} as UTSJSONObject, true, currentAIMemberToken(), key)
		return Promise.resolve(failure<T>(40001, '请求参数无效'))
	}
	// AI只读入口复用会员Bearer/JSON处理，不接受任意地址、写入或自由查询参数。
	public static aiRead<T>(path : string) : Promise<MemberApiResult<T>> {
		if (!/^\/api\/v1\/ai\/tasks(?:\?limit=20(?:&before_id=[1-9][0-9]*)?|\/[1-9][0-9]*(?:\/report)?)?$/.test(path)) {
			return Promise.resolve(failure<T>(40001, '查询参数无效'))
		}
		return requestWithToken<T>(path, 'GET', {} as UTSJSONObject, true, currentAIMemberToken())
	}
	public static profile() : Promise<MemberApiResult<MemberProfile>> {
		return requestApi<MemberProfile>('/api/v1/member/profile', 'GET', {} as UTSJSONObject, true)
	}

	public static sendSms(phone : string) : Promise<MemberApiResult<null>> {
		return requestApi<null>('/api/v1/auth/sms-code', 'POST', { phone: phone } as UTSJSONObject, false)
	}

	public static login(phone : string, code : string, agreed : boolean) : Promise<MemberApiResult<LoginResponse>> {
		return requestApi<LoginResponse>('/api/v1/auth/login', 'POST', {
			phone: phone,
			code: code,
			agreed: agreed
		} as UTSJSONObject, false)
	}

	public static redeem(code : string) : Promise<MemberApiResult<RedeemResponse>> {
		return requestApi<RedeemResponse>('/api/v1/member/redeem', 'POST', { code: code } as UTSJSONObject, true)
	}

	public static deactivate(confirmed : boolean) : Promise<MemberApiResult<null>> {
		return requestApi<null>('/api/v1/member/deactivate', 'POST', { confirmed: confirmed } as UTSJSONObject, true)
	}
}
