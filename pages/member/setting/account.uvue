	padding: 8px 0 20px;
}

.brand-title {
	font-size: 24px;
	font-weight: bold;
	color: #333333;
	padding-left: 4px;
}

.brand-sub {
	margin-top: 8px;
	font-size: 13px;
	color: #999999;
	padding-left: 4px;
}

.cur-account-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 4px 2px;
}

.cur-account-label {
	font-size: 14px;
	color: #666666;
}

.cur-account-value {
	font-size: 15px;
	color: #333333;
	font-weight: bold;
}

.section-title {
	padding: 20px 4px 12px;
}

.section-title-text {
	font-size: 15px;
	font-weight: bold;
	color: #333333;
}

.form-card {
	background: #FFFFFF;
	border-radius: 16px;
	padding: 24px 20px 20px;
	box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
}

.field {
	margin-bottom: 16px;
}

.tip {
	margin: -6px 0 20px;
	padding-left: 2px;
}

.btn-wrap {
	padding: 4px 0 0;
}
</style>
