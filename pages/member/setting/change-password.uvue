<template>
  <view class="page">
    <view class="brand">
      <view class="brand-title">
        <x-text fontSize="24" _style="font-weight:bold" color="#333333">修改密码</x-text>
      </view>
      <view class="brand-sub">
        <x-text fontSize="13" color="#999999">需要先登录，验证原密码后设置新密码</x-text>
      </view>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card">
      <view class="field">
        <x-input v-model="oldPassword" placeholder="请输入原密码" round="12" password leftIcon="lock-2-line" :maxlength="20" height="48"></x-input>
      </view>

      <view class="field">
        <x-input v-model="newPassword" placeholder="请输入新密码（6-20位）" round="12" password leftIcon="lock-2-line" :maxlength="20" height="48"></x-input>
      </view>

      <view class="field">
        <x-input v-model="confirmPassword" placeholder="请再次确认新密码" round="12" password leftIcon="lock-2-line" :maxlength="20" height="48"></x-input>
      </view>

      <view class="btn-wrap">
        <x-button color="#E93030" fontColor="#FFFFFF" :block="true" :round="28" :height="48" :loading="loading" :disabled="loading" @click="doChange">确认修改</x-button>
      </view>
    </view>
  </view>
</template>

<script lang="ts" setup>
import { ref } from 'vue'
import { api as memberApi } from '@/api/member/member.uts'

const oldPassword = ref('')
const newPassword = ref('')
const confirmPassword = ref('')
const loading = ref(false)

const isLoggedIn = () : boolean => {
	return (uni.getStorageSync('token') || '') != ''
}

const doChange = async () => {
	if (loading.value) {
		return
	}
	if (!isLoggedIn()) {
		uni.showToast({ title: '请先登录', icon: 'none' })
		uni.navigateTo({ url: '/pages/member/login' })
		return
	}
	if ((oldPassword.value || '').trim() == '') {
		uni.showToast({ title: '请输入原密码', icon: 'none' })
		return
	}
	if (newPassword.value.length < 6) {
		uni.showToast({ title: '新密码不能少于6位', icon: 'none' })
		return
	}
	if (newPassword.value != confirmPassword.value) {
		uni.showToast({ title: '两次输入的密码不一致', icon: 'none' })
		return
	}

	loading.value = true
	try {
		let ok = await memberApi.changePassword(oldPassword.value, newPassword.value)
		if (ok) {
			uni.showToast({ title: '修改成功', icon: 'success' })
			uni.navigateBack()
		}
	} finally {
		loading.value = false
	}
}
</script>

<style scoped>
.page {
	min-height: 100vh;
	background: #F5F5F5;
	flex-direction: column;
	padding: 24px 16px 32px;
}

.brand {
	padding: 40px 0 28px;
}

.brand-title {
	font-size: 24px;
	font-weight: bold;
	color: #333333;
	padding-left: 4px;
}

.brand-sub {
	margin-top: 8px;
	font-size: 13px;
	color: #999999;
	padding-left: 4px;
}

.form-card {
	background: #FFFFFF;
	border-radius: 16px;
	padding: 24px 20px 20px;
	box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
}

.field {
	margin-bottom: 16px;
}

.btn-wrap {
	padding: 8px 0 0;
}
</style>