<script setup lang="ts">
import { computed, onBeforeUnmount, ref } from 'vue'
import PageHeader from '@/pages/components/PageHeader.uvue'
import { MemberApi } from '@/pages/libs/member-api.uts'
import { LoginViewState, getCountdownLabel, isValidLoginResponse } from '@/pages/libs/member.uts'

// 正式协议、短信服务和会员后端尚未完成。保持登录入口关闭，不在前端留存或发送手机号。
const loginEnabled : boolean = false
const phone = ref<string>('')
const verificationCode = ref<string>('')
const agreed = ref<boolean>(false)
const countdown = ref<number>(0)
const loginState = ref<LoginViewState>(loginEnabled ? 'idle' : 'closed')
const errorMessage = ref<string>('')
let countdownTimer : number = 0
let requestSequence : number = 0

const isPhoneValid = (value : string) : boolean => {
	if (value.length != 11) {
		return false
	}
	for (let index = 0; index < value.length; index++) {
		const character = value.charAt(index)
		if (character < '0' || character > '9') {
			return false
		}
	}
	return value.charAt(0) == '1'
}

const isCodeValid = (value : string) : boolean => {
	if (value.length < 4 || value.length > 8) {
		return false
	}
	for (let index = 0; index < value.length; index++) {
		const character = value.charAt(index)
		if (character < '0' || character > '9') {
			return false
		}
	}
	return true
}

const codeActionLabel = computed(() : string => getCountdownLabel(countdown.value))

const loginButtonLabel = computed(() : string => {
	if (loginState.value == 'sending') {
		return '发送中…'
	}
	if (loginState.value == 'submitting') {
		return '登录中…'
	}
	return loginEnabled ? '登录' : '暂未开放登录'
})

const loginButtonDisabled = computed(() : boolean => {
	return !loginEnabled || loginState.value == 'sending' || loginState.value == 'submitting' || !agreed.value
})

const openService = () : void => {
	uni.navigateTo({ url: '/pages/member/service' })
}

const openPrivacy = () : void => {
	uni.navigateTo({ url: '/pages/member/privacy' })
}

const showUnavailable = () : void => {
	uni.showToast({ title: '登录服务尚未开放', icon: 'none' })
}

const clearCountdown = () : void => {
	if (countdownTimer > 0) {
		clearInterval(countdownTimer)
		countdownTimer = 0
	}
}

const startCountdown = () : void => {
	clearCountdown()
	countdown.value = 60
	countdownTimer = setInterval(() => {
		if (countdown.value <= 1) {
			countdown.value = 0
			clearCountdown()
			return
		}
		countdown.value = countdown.value - 1
	}, 1000)
}

const toggleAgreement = () : void => {
	if (!loginEnabled || loginState.value == 'sending' || loginState.value == 'submitting') {
		return
	}
	agreed.value = !agreed.value
}

const sendCode = async () : Promise<void> => {
	if (!loginEnabled) {
		showUnavailable()
		return
	}
	if (countdown.value > 0 || loginState.value == 'sending') {
		return
	}
	if (!agreed.value) {
		errorMessage.value = '请先阅读并同意用户协议与隐私政策'
		loginState.value = 'error'
		return
	}
	if (!isPhoneValid(phone.value.trim())) {
		errorMessage.value = '请输入有效的手机号'
		loginState.value = 'error'
		return
	}
	const requestID = requestSequence + 1
	requestSequence = requestID
	loginState.value = 'sending'
	errorMessage.value = ''
	const result = await MemberApi.sendSms(phone.value.trim())
	if (requestID != requestSequence) {
		return
	}
	if (result.code != 0) {
		loginState.value = 'error'
		errorMessage.value = result.message
		return
	}
	loginState.value = 'idle'
	startCountdown()
}

const submitLogin = async () : Promise<void> => {
	if (!loginEnabled) {
		showUnavailable()
		return
	}
	if (loginState.value == 'sending' || loginState.value == 'submitting') {
		return
	}
	if (!agreed.value) {
		errorMessage.value = '请先阅读并同意用户协议与隐私政策'
		loginState.value = 'error'
		return
	}
	if (!isPhoneValid(phone.value.trim())) {
		errorMessage.value = '请输入有效的手机号'
		loginState.value = 'error'
		return
	}
	if (!isCodeValid(verificationCode.value.trim())) {
		errorMessage.value = '请输入有效的验证码'
		loginState.value = 'error'
		return
	}
	const requestID = requestSequence + 1
	requestSequence = requestID
	loginState.value = 'submitting'
	errorMessage.value = ''
	const result = await MemberApi.login(phone.value.trim(), verificationCode.value.trim(), agreed.value)
	if (requestID != requestSequence) {
		return
	}
	const loginResponse = result.data
	if (result.code != 0 || loginResponse == null || !isValidLoginResponse(loginResponse)) {
		loginState.value = 'error'
		errorMessage.value = result.code == 0 ? '登录响应不完整，请稍后重试' : result.message
		return
	}
	uni.setStorageSync('tm_member_token', loginResponse.token)
	loginState.value = 'success'
	uni.navigateBack({
		fail: () => {
			uni.switchTab({ url: '/pages/member/index' })
		}
	})
}

const retryLogin = () : void => {
	requestSequence = requestSequence + 1
	errorMessage.value = ''
	loginState.value = loginEnabled ? 'idle' : 'closed'
}

onBeforeUnmount(() => {
	requestSequence = requestSequence + 1
	clearCountdown()
})
</script>

<template>
	<view class="shell">
		<PageHeader title="登录" :showBack="true"></PageHeader>
		<scroll-view class="page" scroll-y="true">
			<view class="hero">
				<view class="hero-icon"><text class="hero-icon-copy">题</text></view>
				<text class="eyebrow">账号服务</text>
				<text class="title">手机号登录</text>
				<text class="subtitle">登录仅用于账号识别、服务状态和注销处理。正式协议、短信服务与账号后端完成前，入口保持关闭。</text>
			</view>

			<view class="form-card">
				<text class="form-title">登录服务准备中</text>
				<text class="form-subtitle">当前不会收集手机号、验证码或其他个人信息。</text>
				<view class="field disabled-field">
					<text class="field-label">手机号</text>
					<input v-model="phone" class="field-input" :disabled="!loginEnabled" maxlength="11" type="number" placeholder="服务开放后输入手机号" />
				</view>
				<view class="field disabled-field">
					<text class="field-label">验证码</text>
					<input v-model="verificationCode" class="field-input" :disabled="!loginEnabled" maxlength="8" type="number" placeholder="服务开放后输入验证码" />
					<text class="code-action" @click="sendCode">{{ codeActionLabel }}</text>
				</view>
				<view class="agreement">
					<view :class="agreed ? 'checkbox checkbox-checked' : 'checkbox'" @click="toggleAgreement"><text v-if="agreed" class="checkbox-mark">✓</text></view>
					<view class="agreement-copy">
						<text class="agreement-copy-prefix">服务开放后，需阅读并同意正式发布的</text>
						<text class="agreement-link" @click="openPrivacy">用户协议与隐私政策</text>
						<text class="agreement-copy-suffix">。</text>
					</view>
				</view>
				<view :class="loginButtonDisabled ? 'login-button disabled-button' : 'login-button active-button'" @click="submitLogin"><text class="login-button-copy">{{ loginButtonLabel }}</text></view>
				<text class="form-link">{{ agreed ? '已勾选协议后才可提交' : '未勾选协议前不可登录' }}</text>
			</view>

			<view v-if="errorMessage.length > 0" class="error-card">
				<text class="error-title">登录未完成</text>
				<text class="error-copy">{{ errorMessage }}</text>
				<text class="retry-action" @click="retryLogin">重新填写</text>
			</view>

			<view v-if="!loginEnabled" class="hint-card">
				<view class="hint-icon"><text class="hint-icon-copy">i</text></view>
				<text class="hint-copy">验证码发送频控、错误次数和协议同意记录均由服务端处理；前端不会用本地状态代替服务端结果。</text>
			</view>

			<view class="link-card">
				<text class="link-title">登录前请先了解</text>
				<view class="link-row" @click="openService">
					<text class="link-copy">服务说明</text>
					<text class="link-arrow">›</text>
				</view>
				<view class="link-row" @click="openPrivacy">
					<text class="link-copy">协议与隐私</text>
					<text class="link-arrow">›</text>
				</view>
			</view>

			<view class="notice">
				<text class="notice-copy">本平台为公开信息聚合与历史数据统计，不构成任何投资建议。</text>
			</view>
		</scroll-view>
	</view>
</template>

<style scoped>
.shell, .page { flex: 1; }
.page { padding-bottom: 64px; background-color: #f5f6f8; }
.hero { padding: 28px 20px 26px; align-items: center; background-color: #ffffff; }
.hero-icon { width: 54px; height: 54px; margin-bottom: 14px; justify-content: center; align-items: center; border-radius: 16px; background-color: #fff0f0; }
.hero-icon-copy { font-size: 22px; font-weight: 700; color: #e93030; }
.eyebrow { font-size: 13px; font-weight: 600; color: #e93030; }
.title { margin-top: 7px; font-size: 24px; font-weight: 700; color: #20242b; }
.subtitle { margin-top: 8px; font-size: 14px; line-height: 21px; color: #737983; text-align: center; }
.form-card, .link-card { margin: 16px; padding: 20px; border-radius: 18px; background-color: #ffffff; }
.form-title, .link-title { font-size: 17px; font-weight: 700; color: #292d34; }
.form-subtitle { margin-top: 6px; font-size: 12px; line-height: 18px; color: #7a818c; }
.field { min-height: 54px; margin-top: 16px; padding: 0 14px; flex-direction: row; align-items: center; border-radius: 10px; background-color: #f7f8fa; }
.field-label { width: 58px; font-size: 14px; color: #606773; }
.field-input { flex: 1; font-size: 14px; color: #a0a5ad; }
.code-action { min-width: 84px; min-height: 44px; padding-top: 13px; font-size: 13px; color: #b4b8bf; text-align: right; }
.agreement { margin-top: 18px; flex-direction: row; align-items: flex-start; }
.checkbox { width: 18px; height: 18px; margin: 2px 8px 0 0; justify-content: center; align-items: center; border-width: 1px; border-color: #c9cdd3; border-radius: 4px; }
.checkbox-checked { border-color: #e93030; background-color: #e93030; }
.checkbox-mark { font-size: 12px; font-weight: 700; color: #ffffff; }
.agreement-copy { flex: 1; flex-direction: row; flex-wrap: wrap; font-size: 12px; line-height: 19px; color: #8a9099; }
.agreement-copy-prefix, .agreement-copy-suffix { font-size: 12px; line-height: 19px; color: #8a9099; }
.agreement-link { color: #e93030; }
.login-button { min-height: 48px; margin-top: 20px; justify-content: center; align-items: center; border-radius: 24px; }
.disabled-button { background-color: #d9dce1; }
.active-button { background-color: #e93030; }
.login-button-copy { font-size: 16px; font-weight: 600; color: #ffffff; }
.form-link { margin-top: 12px; font-size: 12px; color: #89909a; text-align: center; }
.error-card { margin: 16px; padding: 16px; border-radius: 14px; background-color: #fff2f1; }
.error-title { font-size: 14px; font-weight: 700; color: #a5453e; }
.error-copy { margin-top: 5px; font-size: 13px; line-height: 19px; color: #96534d; }
.retry-action { min-height: 44px; margin-top: 8px; padding-top: 12px; font-size: 13px; font-weight: 700; color: #e93030; }
.hint-card { margin: 16px; padding: 13px 14px; flex-direction: row; align-items: flex-start; border-radius: 13px; background-color: #fff8eb; }
.hint-icon { width: 18px; height: 18px; margin: 1px 8px 0 0; justify-content: center; align-items: center; border-radius: 9px; background-color: #edaa2b; }
.hint-icon-copy { font-size: 11px; font-weight: 700; color: #ffffff; }
.hint-copy { flex: 1; font-size: 12px; line-height: 18px; color: #89642b; }
.link-card { padding: 8px 20px; }
.link-row { min-height: 54px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #f0f1f3; }
.link-row:last-child { border-bottom-width: 0; }
.link-copy { flex: 1; font-size: 14px; color: #3d424a; }
.link-arrow { min-width: 32px; min-height: 44px; padding-top: 9px; font-size: 22px; color: #bec2c8; text-align: right; }
.notice { margin: 24px; }
.notice-copy { font-size: 12px; line-height: 18px; color: #9aa1aa; text-align: center; }
</style>
