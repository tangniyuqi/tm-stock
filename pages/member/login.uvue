<template>
  <view class="page">
    <!-- 品牌区 -->
    <view class="brand">
      <view class="brand-logo">
        <x-icon name="stock-line" color="#FFFFFF" font-size="30"></x-icon>
      </view>

      <view class="brand-title">
        <text>题材助手</text>
      </view>
    </view>

    <!-- 登录方式切换 -->
    <view class="mode-switch">
      <view class="mode-tabs">
        <view class="mode-tab" :class="!isCodeLogin ? 'mode-tab-active' : ''" @click="switchToPassword">
          <text :class="!isCodeLogin ? 'text-active' : ''">密码登录</text>
        </view>
        <view class="mode-tab" :class="isCodeLogin ? 'mode-tab-active' : ''" @click="switchToCode">
          <text :class="isCodeLogin ? 'text-active' : ''">验证码登录</text>
        </view>
      </view>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card">
      <!-- 密码登录 -->
      <block v-if="!isCodeLogin">
        <view class="field">
          <x-input v-model="account" placeholder="请输入手机号/用户名" round="12" leftIcon="user-3-line" height="48"></x-input>
        </view>
        <view class="field">
          <x-input v-model="password" placeholder="请输入密码" round="12" password leftIcon="lock-2-line" height="48"></x-input>
        </view>
      </block>

      <!-- 验证码登录 -->
      <block v-else>
        <view class="field">
          <x-input v-model="phone" placeholder="请输入手机号" round="12" type="tel" inputmode="numeric" :maxlength="11" leftIcon="phone-line" height="48"></x-input>
        </view>
        <view class="field">
          <view class="code-row">
            <x-input v-model="smsCode" class="code-input" placeholder="请输入验证码" round="12" type="number" inputmode="numeric" :maxlength="6" height="48"></x-input>
            <view class="get-code" :class="countdown > 0 ? 'get-code-disabled' : ''" @click="getSmsCode">
              <text class="get-code-text">{{ countdown > 0 ? countdown + 's后重发' : '获取验证码' }}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 忘记密码 -->
      <view class="forget-row">
        <view @click="goForget">
          <text class="link-text">忘记密码？</text>
        </view>
      </view>

      <!-- 登录按钮 -->
      <view class="btn-wrap">
        <x-button color="#E93030" fontColor="#FFFFFF" :block="true" :round="28" :height="48" :loading="loading" :disabled="loading" @click="doLogin">登录</x-button>
      </view>

      <!-- 去注册 -->
      <view class="register-row">
        <text class="tip-text">还没有账号？</text>
        <view @click="goRegister">
          <text class="link-text">立即注册</text>
        </view>
      </view>
    </view>

    <!-- 底部合规免责 -->
    <view class="footer">
      <text class="footer-text">登录即表示同意《用户协议》与《隐私政策》</text>
    </view>
  </view>
</template>

<script lang="ts" setup>
import { ref, onBeforeUnmount } from 'vue'
import { api as authApi } from '@/api/auth.uts'
import { api as memberApi } from '@/api/member/member.uts'

// 登录方式：false=密码登录，true=验证码登录
const isCodeLogin = ref(false)

// 密码登录字段
const account = ref('')
const password = ref('')
// 验证码登录字段
const phone = ref('')
const smsCode = ref('')
// 验证码倒计时（秒）
const countdown = ref(0)
// 登录中状态
const loading = ref(false)

// 非响应式计时器 id
let intervalId : number = -1

// 手机号合法性校验（以 1 开头的 11 位数字）
const isValidPhone = (num : string) : boolean => {
	let n = (num || '').trim()
	if (n.length != 11) {
		return false
	}
	return n.charAt(0) == '1'
}

// 校验字符串非空
const isEmpty = (val : string) : boolean => {
	return (val || '').trim() == ''
}

// 切换为密码登录
const switchToPassword = () => {
	isCodeLogin.value = false
}

// 切换为验证码登录
const switchToCode = () => {
	isCodeLogin.value = true
}

// 停止倒计时
const stopCountdown = () => {
	if (intervalId != -1) {
		clearInterval(intervalId)
		intervalId = -1
	}
}

// 启动验证码倒计时
const startCountdown = () => {
	countdown.value = 60
	intervalId = setInterval(() : void => {
		countdown.value = countdown.value - 1
		if (countdown.value <= 0) {
			stopCountdown()
		}
	}, 1000)
}

// 获取验证码
const getSmsCode = async () => {
	if (countdown.value > 0) {
		return
	}
	if (!isValidPhone(phone.value)) {
		uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
		return
	}
	let ok = await authApi.sendCode(phone.value.trim(), 'login')
	if (ok) {
		uni.showToast({ title: '验证码已发送', icon: 'none' })
		startCountdown()
	}
}

// 登录后加载用户资料并保存本地，然后返回登录前页面。
// 注意：资料请求失败不能阻塞跳转，否则会出现“登录成功但不跳转”。
const saveProfileAndGoHome = async () => {
	try {
		let profile = await memberApi.getProfile()
		if (profile != null) {
			uni.setStorageSync('nickname', profile.nickname)
			uni.setStorageSync('mobile', profile.mobile)
			uni.setStorageSync('credit', String(profile.credit))
			uni.setStorageSync('level', String(profile.level))
			if (profile.level > 0) {
				uni.setStorageSync('vipExpire', 'VIP' + profile.level)
			}
		}
	} catch (e) {
		// 资料获取失败不影响登录成功后跳转
	}

	// 返回登录前的页面；若无可返回页面则跳到个人中心
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack()
	} else {
		uni.switchTab({ url: '/pages/member/index' })
	}
}

// 登录提交
const doLogin = async () => {
	if (loading.value) {
		return
	}
	// 校验
	let mobile = ''
	if (!isCodeLogin.value) {
		if (isEmpty(account.value)) {
			uni.showToast({ title: '请输入手机号或用户名', icon: 'none' })
			return
		}
		if (isEmpty(password.value)) {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return
		}
		mobile = account.value.trim()
	} else {
		if (!isValidPhone(phone.value)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		if (isEmpty(smsCode.value)) {
			uni.showToast({ title: '请输入验证码', icon: 'none' })
			return
		}
		mobile = phone.value.trim()
	}

	loading.value = true
	try {
		let resp = await authApi.login(
			mobile,
			isCodeLogin.value ? '' : password.value,
			isCodeLogin.value ? smsCode.value.trim() : ''
		)
		if (resp != null) {
			uni.setStorageSync('token', resp.token)
			uni.setStorageSync('loginMobile', mobile)
			uni.showToast({ title: '登录成功', icon: 'success' })
			await saveProfileAndGoHome()
		}
	} finally {
		loading.value = false
	}
}

// 跳转注册
const goRegister = () => {
	uni.navigateTo({ url: '/pages/member/register' })
}

// 跳转忘记密码
const goForget = () => {
	uni.navigateTo({ url: '/pages/member/forget' })
}

onBeforeUnmount(() => {
	stopCountdown()
})
</script>

<style scoped>
.page {
	min-height: 100vh;
	background: #F5F5F5;
	flex-direction: column;
	padding: 24px 16px 32px;
}

.brand {
	align-items: center;
	padding: 44px 0 28px;
}

.brand-logo {
	width: 72px;
	height: 72px;
	border-radius: 20px;
	background: linear-gradient(135deg, #F2554F, #E93030);
	align-items: center;
	justify-content: center;
	box-shadow: 0 8px 20px rgba(233, 48, 48, 0.3);
}

.brand-title {
	margin-top: 14px;
	font-size: 22px;
	font-weight: bold;
	color: #333333;
}

.mode-switch {
	margin-bottom: 16px;
}

.mode-tabs {
	flex-direction: row;
	border-radius: 12px;
	background: #FFFFFF;
	padding: 4px;
}

.mode-tab {
	flex: 1;
	height: 44px;
	align-items: center;
	justify-content: center;
	border-radius: 10px;
}

.mode-tab-active {
	background: #E93030;
}

.text-active {
	color: #FFFFFF !important;
	font-weight: bold;
}

.mode-tab text {
	font-size: 15px;
	color: #666666;
}

.form-card {
	background: #FFFFFF;
	border-radius: 16px;
	padding: 24px 20px 20px;
	box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
}

.field {
	margin-bottom: 16px;
}

.code-row {
	flex-direction: row;
	align-items: center;
}

.code-input {
	flex: 1;
}

.get-code {
	margin-left: 12px;
	height: 48px;
	padding: 0 18px;
	border-radius: 12px;
	background: #FFF0F0;
	align-items: center;
	justify-content: center;
	border: 1rpx solid #F7C7C7;
}

.get-code-disabled {
	background: #F5F5F5;
	border-color: #EEEEEE;
}

.get-code-text {
	font-size: 13px;
	color: #E93030;
}

.get-code-disabled .get-code-text {
	color: #999999;
}

.forget-row {
	flex-direction: row;
	justify-content: flex-end;
	padding: 2px 4px 16px;
}

.btn-wrap {
	padding: 4px 0 0;
}

.register-row {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	margin-top: 18px;
}

.tip-text {
	font-size: 14px;
	color: #999999;
	margin-right: 2px;
}

.link-text {
	font-size: 14px;
	color: #E93030;
}

.footer {
	align-items: center;
	margin-top: 28px;
}

.footer-text {
	font-size: 12px;
	color: #999999;
}
</style>