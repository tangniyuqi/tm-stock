<template>
  <scroll-view class="page" scroll-y="true" show-scrollbar="false">
    <!-- 顶部渐变头部 -->
    <x-sheet class="hero" :linearGradient="['bottom','#F2554F','#E93030']" margin="0" :round="['0','0','0','0']">
      <view class="hero-inner">
        <view class="hero-settings" @click="goSetting">
          <x-icon name="settings-3-line" color="#FFFFFF" font-size="20"></x-icon>
        </view>

        <view class="profile-card">
          <view class="avatar-wrap" @click="handleProfileClick">
            <image class="avatar-logo" :src="avatar" mode="aspectFill"></image>
          </view>

          <view class="profile-info" @click="handleProfileClick">
            <x-text color="#FFFFFF" font-size="15" class="text-weight-b">{{ nickname }}</x-text>

            <x-text v-if="name != ''" color="#FFFFFF" font-size="14" alpha="0.8">{{ name }}</x-text>

            <x-text color="#FFFFFF" font-size="14" alpha="0.85">{{ maskedMobile }}</x-text>
          </view>
        </view>
      </view>
    </x-sheet>

    <view class="content">
      <!-- 常用功能卡片 -->
      <x-sheet class="menu-card" margin="0" padding="6px 0" :round="['16','16','16','16']" :shadow="['10','24','rgba(0,0,0,0.06)']">
        <x-cell icon="vip-crown-2-line" icon-color="#E93030" icon-size="18" title="VIP会员"
          title-color="#333333" title-size="16" :label="isLoggedIn() ? vipExpire : '未登录'" link :card="false" bottomBorderInsert @click="comingSoon"></x-cell>

        <x-cell icon="coin-line" icon-color="#E93030" icon-size="18" title="我的积分"
          title-color="#333333" title-size="16" :label="isLoggedIn() ? credit : '未登录'" link :card="false" bottomBorderInsert @click="goCredit"></x-cell>
        
        <x-cell icon="settings-3-line" icon-color="#E93030" icon-size="18" title="个人设置"
          title-color="#333333" title-size="16" :label="isLoggedIn() ? '' : '未登录'" link :card="false" bottomBorderInsert :showBottomBorder="false" @click="goSetting"></x-cell>
      </x-sheet>

      <!-- 服务与支持宫格 -->
      <x-sheet class="support-card" margin="18px 0 0 0" :round="['16','16','16','16']" :shadow="['10','24','rgba(0,0,0,0.06)']">
        <x-grid :col="3" icon-color="#9E9E9E" text-color="#666666" font-size="14" icon-size="28"
          :show-border="false">
          <x-grid-item :order="0" icon="information-line" text="关于我们" @click="goCmsSingle('About')"></x-grid-item>
          <x-grid-item :order="1" icon="mail-line" text="联系方式" @click="goCmsSingle('Contacts')"></x-grid-item>
          <x-grid-item :order="3" icon="message-3-line" text="意见反馈" @click="goFeedback"></x-grid-item>
          <x-grid-item :order="2" icon="question-line" text="帮助中心" @click="goHelp"></x-grid-item>
        </x-grid>
      </x-sheet>

      <!-- 底部合规免责 -->
      <view class="footer">
        <x-text font-size="13" color="#B5B5B5" class="footer-version">题材助手 v1.0.0</x-text>
      </view>
    </view>
  </scroll-view>
</template>

<script lang="ts" setup>
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { api as memberApi } from '@/api/member/member.uts'
import { MemberProfile } from '@/types/interface.uts'

// 头像默认
const avatar = ref('/static/images/avatar.png')

// 用户信息
const nickname = ref('登录 / 注册')
const name = ref('')
const maskedMobile = ref('登录后解锁更多功能')
const credit = ref('0')
const vipExpire = ref('未开通或已过期')

// 手机号脱敏
const maskPhone = (num: string) => {
  const cleaned = (num || '').trim()
  if (cleaned.length < 7) return cleaned || '未绑定手机号'
  return cleaned.slice(0, 3) + '****' + cleaned.slice(-4)
}

// 是否已登录
const isLoggedIn = () : boolean => {
	return (uni.getStorageSync('token') || '') != ''
}

// 刷新用户信息（从后端获取）
const refreshProfile = async () => {
	if (!isLoggedIn()) {
		nickname.value = '登录 / 注册'
		name.value = ''
		maskedMobile.value = '登录后解锁更多功能'
		credit.value = '0'
		vipExpire.value = '未开通或已过期'
		return
	}

	// 获取用户名（账号，可登录用）
	let acc = await memberApi.getSettings()
	name.value = (acc != null && acc.name != '') ? acc.name : ''

	let profile: MemberProfile | null = null
	try {
		profile = await memberApi.getProfile()
	} catch (e) {
		// 请求失败时回退本地缓存，避免中断资料刷新
		profile = null
	}
	if (profile != null) {
		nickname.value = profile.nickname || '题材助手'
		maskedMobile.value = maskPhone(profile.mobile)
		credit.value = String(profile.credit)
		avatar.value = profile.avatar || '/static/images/avatar.png'
		let level = profile.level
		vipExpire.value = level > 0 ? 'VIP' + level : '未开通或已过期'

		// 更新本地缓存（兼容旧逻辑）
		uni.setStorageSync('nickname', profile.nickname)
		uni.setStorageSync('mobile', profile.mobile)
		uni.setStorageSync('credit', String(profile.credit))
		uni.setStorageSync('level', String(level))
	} else {
		// API 失败时回退到本地缓存，避免已登录用户看到「登录 / 注册」
		let cachedNickname = uni.getStorageSync('nickname') as string
		let cachedMobile = uni.getStorageSync('mobile') as string
		let cachedCredit = uni.getStorageSync('credit') as string
		let cachedLevel = uni.getStorageSync('level') as string
		if (cachedNickname != null && cachedNickname != '') {
			nickname.value = cachedNickname
		} else {
			nickname.value = '已登录'
		}
		if (cachedMobile != null && cachedMobile != '') {
			maskedMobile.value = maskPhone(cachedMobile)
		} else {
			let loginMobile = uni.getStorageSync('loginMobile') as string
			maskedMobile.value = (loginMobile != null && loginMobile != '') ? maskPhone(loginMobile) : '已登录'
		}
		if (cachedCredit != null && cachedCredit != '') {
			credit.value = cachedCredit
		}
		if (cachedLevel != null && cachedLevel != '') {
			let lv = parseInt(cachedLevel)
			vipExpire.value = lv > 0 ? 'VIP' + lv : '未开通或已过期'
		}
	}
}

// 跳转登录
const goLogin = () => {
	uni.navigateTo({ url: '/pages/member/login' })
}

// 未登录时点击进入登录，已登录时进入个人设置
const handleProfileClick = () => {
	if (!isLoggedIn()) {
		goLogin()
	} else {
		goSetting()
	}
}

onShow(() => {
	refreshProfile()
})

// 跳转设置（未登录时需先登录）
const goSetting = () => {
  if (!isLoggedIn()) {
    uni.navigateTo({ url: '/pages/member/login' })
    return
  }
  uni.navigateTo({ url: '/pages/member/setting/index' })
}

// 跳转积分详情（未登录时需先登录）
const goCredit = () => {
  if (!isLoggedIn()) {
    uni.navigateTo({ url: '/pages/member/login' })
    return
  }
  uni.navigateTo({ url: '/pages/member/asset/index' })
}

// ============ 服务与支持（跳转独立页面） ============

// 关于我们 / 联系方式：跳转共用单页模板，按 name 区分
const goCmsSingle = (name: string) => {
	uni.navigateTo({ url: '/pages/cms/page/detail?name=' + name })
}

// 意见反馈：跳转表单页
const goFeedback = () => {
	uni.navigateTo({ url: '/pages/cms/feedback/index' })
}

// 帮助中心：x-collapse 折叠文章页
const goHelp = () => {
	uni.navigateTo({ url: '/pages/cms/help/index' })
}

// 尚未开放的功能
const comingSoon = () => {
  uni.showToast({ title: '功能筹备中，敬请期待', icon: 'none' })
}
</script>

<style scoped>
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

.hero {
  margin: 0;
  padding: 0;
}

.hero-inner {
  padding: 18px 16px 40px 16px;
}

.hero-settings {
  width: 40px;
  height: 40px;
  margin-left: auto;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 40px;
}

.avatar-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border-width: 2px;
  border-style: solid;
  border-color: rgba(255, 255, 255, 0.76);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-logo {
  width: 76px;
  height: 76px;
  border-radius: 30px;
}

.profile-info {
  display: flex;
  flex-direction: column;
  margin-left: 16px;
  flex: 1;
}

.content {
  margin-top: 20px;
  padding: 0 16px 28px;
}

.menu-card {
  margin: 0;
  padding: 6px 0;
}

.support-card {
  margin: 18px 0 0;
  padding: 22px 8px 6px;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 16px 8px;
}

.footer-version {
	line-height: 20px;
}
</style>