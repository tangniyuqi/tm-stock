<template>
  <view class="page">
    <view class="brand">
      <view class="brand-title">
        <text>重置密码</text>
      </view>
      <view class="brand-sub">
        <text>为 {{ resetMobile }} 设置新密码</text>
      </view>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card">
      <view class="field">
        <x-input v-model="newPassword" placeholder="请输入新密码（6-20位）" round="12" password leftIcon="lock-2-line" :maxlength="20" height="48"></x-input>
      </view>

      <view class="field">
        <x-input v-model="confirmPassword" placeholder="请再次确认新密码" round="12" password leftIcon="lock-2-line" :maxlength="20" height="48"></x-input>
      </view>

      <view class="btn-wrap">
        <x-button color="#E93030" fontColor="#FFFFFF" :block="true" :round="28" :height="48" :loading="loading" :disabled="loading" @click="doReset">确认重置</x-button>
      </view>

      <view class="login-row">
        <text class="tip-text">想起密码了？</text>
        <view @click="goLogin">
          <text class="link-text">直接登录</text>
        </view>
      </view>
    </view>

    <view class="footer">
      <text class="footer-disclaimer">本平台为公开信息聚合与历史数据统计，不构成任何投资建议。</text>
    </view>
  </view>
</template>

<script lang="ts" setup>
import { ref } from 'vue'
import { api as authApi } from '@/api/auth.uts'

// 从找回密码页带过来的已验证手机号和验证码
const resetMobile = ref(uni.getStorageSync('resetMobile') || '')
const resetCode = ref(uni.getStorageSync('resetCode') || '')

const newPassword = ref('')
const confirmPassword = ref('')
const loading = ref(false)

// 重置密码提交
const doReset = async () => {
	if (loading.value) {
		return
	}
	if (!resetMobile.value) {
		uni.showToast({ title: '请先通过手机验证', icon: 'none' })
		uni.navigateTo({ url: '/pages/member/forget' })
		return
	}
	if (newPassword.value.length < 6) {
		uni.showToast({ title: '新密码不能少于6位', icon: 'none' })
		return
	}
	if (newPassword.value != confirmPassword.value) {
		uni.showToast({ title: '两次输入的密码不一致', icon: 'none' })
		return
	}

	loading.value = true
	try {
		let ok = await authApi.resetPwd(
			resetMobile.value,
			resetCode.value,
			newPassword.value
		)
		if (ok) {
			uni.showToast({ title: '重置成功', icon: 'success' })
			uni.removeStorageSync('resetMobile')
			uni.removeStorageSync('resetCode')
			uni.navigateTo({ url: '/pages/member/login' })
		}
	} finally {
		loading.value = false
	}
}

const goLogin = () => {
	uni.navigateTo({ url: '/pages/member/login' })
}
</script>

