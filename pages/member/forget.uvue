.page {
	min-height: 100vh;
	background: #F5F5F5;
	flex-direction: column;
	padding: 24px 16px 32px;
}

.brand {
	padding: 40px 0 28px;
}

.brand-title {
	font-size: 24px;
	font-weight: bold;
	color: #333333;
	padding-left: 4px;
}

.brand-sub {
	margin-top: 8px;
	font-size: 13px;
	color: #999999;
	padding-left: 4px;
}

.form-card {
	background: #FFFFFF;
	border-radius: 16px;
	padding: 24px 20px 20px;
	box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
}

.field {
	margin-bottom: 16px;
}

.code-row {
	flex-direction: row;
	align-items: center;
}

.code-input {
	flex: 1;
}

.get-code {
	margin-left: 12px;
	height: 48px;
	padding: 0 18px;
	border-radius: 12px;
	background: #FFF0F0;
	align-items: center;
	justify-content: center;
	border: 1rpx solid #F7C7C7;
}

.get-code-disabled {
	background: #F5F5F5;
	border-color: #EEEEEE;
}

.get-code-text {
	font-size: 13px;
	color: #E93030;
}

.get-code-disabled .get-code-text {
	color: #999999;
}

.btn-wrap {
	padding: 8px 0 0;
}

.login-row {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	margin-top: 18px;
}

.tip-text {
	font-size: 14px;
	color: #999999;
	margin-right: 2px;
}

.link-text {
	font-size: 14px;
	color: #E93030;
}
</style>