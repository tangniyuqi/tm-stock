<template>
  <view class="page">
    <view class="brand">
      <view class="brand-title">
        <text>找回密码</text>
      </view>
      <view class="brand-sub">
        <text>通过手机号 + 验证码验证身份</text>
      </view>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card">
      <view class="field">
        <x-input v-model="phone" placeholder="请输入手机号" round="12" type="tel" inputmode="numeric" :maxlength="11" leftIcon="phone-line" height="48"></x-input>
      </view>

      <view class="field">
        <view class="code-row">
          <x-input v-model="smsCode" class="code-input" placeholder="请输入验证码" round="12" type="number" inputmode="numeric" :maxlength="6" height="48"></x-input>
          <view class="get-code" :class="countdown > 0 ? 'get-code-disabled' : ''" @click="getSmsCode">
            <text class="get-code-text">{{ countdown > 0 ? countdown + 's后重发' : '获取验证码' }}</text>
          </view>
        </view>
      </view>

      <view class="btn-wrap">
        <x-button color="#E93030" fontColor="#FFFFFF" :block="true" :round="28" :height="48" :loading="loading" :disabled="loading" @click="verifyIdentity">下一步</x-button>
      </view>

      <view class="login-row">
        <text class="tip-text">想起密码了？</text>
        <view @click="goLogin">
          <text class="link-text">直接登录</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="ts" setup>
import { ref, onBeforeUnmount } from 'vue'
import { api as authApi } from '@/api/auth.uts'

const phone = ref('')
const smsCode = ref('')
const countdown = ref(0)
const loading = ref(false)

let intervalId : number = -1

const isValidPhone = (num : string) : boolean => {
	let n = (num || '').trim()
	if (n.length != 11) {
		return false
	}
	return n.charAt(0) == '1'
}

const isEmpty = (val : string) : boolean => {
	return (val || '').trim() == ''
}

const stopCountdown = () => {
	if (intervalId != -1) {
		clearInterval(intervalId)
		intervalId = -1
	}
}

const startCountdown = () => {
	countdown.value = 60
	intervalId = setInterval(() : void => {
		countdown.value = countdown.value - 1
		if (countdown.value <= 0) {
			stopCountdown()
		}
	}, 1000)
}

// 发送验证码（先调用 sendCode 下发短信）
const getSmsCode = async () => {
	if (countdown.value > 0) {
		return
	}
	if (!isValidPhone(phone.value)) {
		uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
		return
	}
	let ok = await authApi.sendCode(phone.value.trim(), 'forgot')
	if (ok) {
		uni.showToast({ title: '验证码已发送', icon: 'none' })
		startCountdown()
	}
}

// 身份验证完成后跳转到重置密码页
const verifyIdentity = () => {
	if (loading.value) {
		return
	}
	if (!isValidPhone(phone.value)) {
		uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
		return
	}
	if (isEmpty(smsCode.value)) {
		uni.showToast({ title: '请输入验证码', icon: 'none' })
		return
	}

	// 传递已验证手机号和验证码到重置页
	uni.setStorageSync('resetMobile', phone.value.trim())
	uni.setStorageSync('resetCode', smsCode.value.trim())
	uni.navigateTo({ url: '/pages/member/reset-password' })
}

const goLogin = () => {
	uni.navigateTo({ url: '/pages/member/login' })
}

onBeforeUnmount(() => {
	stopCountdown()
})
</script>

