.sheet-header { min-height: 60px; flex-direction: row; align-items: flex-start; }
.header-copy { flex: 1; padding-top: 8px; }
.title { font-size: 19px; font-weight: 700; color: #1f2329; }
.subtitle { margin-top: 6px; font-size: 13px; color: #7a818c; }
.close-action { min-width: 44px; min-height: 44px; padding-top: 12px; font-size: 14px; font-weight: 700; color: #e93030; text-align: right; }
.sheet-scroll { flex: 1; border-top-width: 1px; border-top-color: #f0f1f3; }
.field { margin-top: 20px; }
.field-last { padding-bottom: 12px; }
.label { font-size: 12px; font-weight: 600; color: #89909a; }
.value, .excerpt, .url-action, .url-unavailable { margin-top: 7px; font-size: 14px; line-height: 21px; color: #30343b; }
.excerpt { padding: 12px; border-radius: 10px; background-color: #f6f7f9; }
