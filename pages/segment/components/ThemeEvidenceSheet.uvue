<script setup lang="ts">
import { isSafeExternalUrl, openSafeExternalUrl } from '@/pages/libs/external-link.uts'
import { Evidence, formatMillis } from '@/pages/libs/theme.uts'

type ThemeEvidenceSheetProps = {
	visible : boolean,
	evidence : Evidence
}

defineProps<ThemeEvidenceSheetProps>()

const emits = defineEmits<{
	close : []
}>()

const close = () : void => {
	emits('close')
}

const openSource = (url : string) : void => {
	openSafeExternalUrl(url)
}
</script>

<template>
	<view v-if="visible" class="overlay" @click="close">
		<view class="sheet" @click.stop>
			<view class="grabber"></view>
			<view class="sheet-header">
				<view class="header-copy">
					<text class="title">归属依据</text>
					<text class="subtitle">{{ evidence.stockName }} · {{ evidence.chainNodeName }}</text>
				</view>
				<text class="close-action" @click="close">关闭</text>
			</view>

			<scroll-view class="sheet-scroll" scroll-y="true">
				<view class="field">
					<text class="label">来源类型</text>
					<text class="value">{{ evidence.sourceType }}</text>
				</view>
				<view class="field">
					<text class="label">原文摘录</text>
					<text class="excerpt">{{ evidence.sourceExcerpt }}</text>
				</view>
				<view class="field">
					<text class="label">原文链接</text>
					<text v-if="isSafeExternalUrl(evidence.sourceUrl)" class="url-action" @click="openSource(evidence.sourceUrl)">查看已校验的 HTTPS 原文</text>
					<text v-else class="url-unavailable">原文链接暂不可用</text>
				</view>
				<view class="field field-last">
					<text class="label">采集时点</text>
					<text class="value">{{ formatMillis(evidence.collectedAt) }}</text>
				</view>
				<text class="sheet-note">缺少来源类型、原文摘录、原文链接或采集时点的记录不会在题材详情中展示。</text>
			</scroll-view>
		</view>
	</view>
</template>

<style scoped>
.overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; padding: 16px; justify-content: flex-end; background-color: rgba(0, 0, 0, 0.42); z-index: 20; }
