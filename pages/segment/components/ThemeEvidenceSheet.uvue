	flex-direction: row;
	align-items: flex-start;
}

.header-copy {
	flex: 1;
}

.title {
	font-size: 18px;
	font-weight: 700;
	color: #1f2329;
}

.subtitle {
	margin-top: 6px;
	font-size: 13px;
	color: #7a818c;
}

.close-action {
	min-width: 44px;
	padding: 10px 0 10px 10px;
	font-size: 14px;
	color: #e93030;
	text-align: right;
}

.field {
	margin-top: 20px;
}

.label {
	font-size: 12px;
	color: #89909a;
}

.value,
.excerpt,
.url {
	margin-top: 6px;
	font-size: 14px;
