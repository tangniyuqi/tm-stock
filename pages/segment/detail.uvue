	font-size: 24px;
	font-weight: 700;
	color: #1f2329;
}

.theme-summary {
	margin-top: 12px;
	font-size: 15px;
	line-height: 23px;
	color: #505762;
}

.updated-at,
.caliber,
.chain-description,
.stock-code {
	margin-top: 8px;
	font-size: 12px;
	line-height: 18px;
	color: #89909a;
}

.locked-card {
	margin-top: 12px;
	align-items: center;
}

.chain-list {
	margin-top: 12px;
}

.chain-card {
	margin-bottom: 12px;
	padding: 16px;
}

.chain-header,
.stock-item {
	flex-direction: row;
	align-items: center;
}

.chain-copy,
.stock-copy {
	flex: 1;
}

.chain-name,
.stock-name {
	font-size: 16px;
	font-weight: 600;
	color: #30343b;
}

.change-value {
	margin-left: 12px;
	font-size: 14px;
	color: #505762;
	text-align: right;
}

.stock-list {
	margin-top: 12px;
	border-top-width: 1px;
	border-top-color: #f0f1f3;
}

.stock-item {
	min-height: 58px;
	border-bottom-width: 1px;
	border-bottom-color: #f0f1f3;
}

.stock-empty {
	margin-top: 12px;
	padding: 14px 0;
	align-items: center;
}

