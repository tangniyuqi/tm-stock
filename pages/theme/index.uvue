<template>
	<view class="page">
		<x-text fontSize="18" color="#333" class="text-weight-b page-title">OCS</x-text>

		<x-sheet color="#E5E5E5" round="8">
			<!-- 描述：最多三行截断，尾部查看按钮；点击后底部弹出抽屉查看全部内容 -->
			<view class="theme-desc" @click="onViewDesc(ocsDesc, 'OCS')">
				<x-text color="#333" fontSize="13" :lines="3" class="theme-desc-text">{{ ocsDesc }}</x-text>

				<view class="theme-view-btn">
					<x-text color="#333" fontSize="13">查看</x-text>
					<x-icon color="#333" fontSize="13" name="arrow-right-s-line" />
				</view>
			</view>
		</x-sheet>

		<!-- 展开全部 / 折叠全部：图标 + 文字，点击切换 -->
		<view class="expand-all-sheet" @click="onExpandAll">
			<x-icon fontSize="14" color="#999" :name="expandAll ? 'arrow-up-s-line' : 'arrow-down-s-line'" />
			<x-text fontSize="12" color="#999">{{ expandAll ? '全部折叠' : '全部展开' }}</x-text>
		</view>

		<!-- 核心折叠面板 -->
		<x-sheet color="#FFF" padding="0" round="16">
			<x-collapse v-model="activeNames" :multiple="expandAll">
				<!-- 细分领域 -->
				<x-collapse-item 
					v-for="(item, index) in items" 
					:key="index"
					:name="'field-' + index" 
					activeColor="#000"
					:show-bottom-line="index !== items.length - 1"
					padding="0"
				>
					<!-- 标题插槽：status 为当前展开状态，展开时变色 -->
					<template #title="{ status }">
						<x-text fontSize="16" :color="status ? '#000' : '#333'">{{ item.segment.name }}</x-text>

						<!-- @click.stop：阻止冒泡，点击查看时不触发折叠/展开 -->
						<!-- <view @click.stop="onViewDesc(item.desc, item.segment.name)">
							<x-text fontSize="13" color="#333">查看</x-text>
						</view> -->
					</template>

					<!-- 子题材描述：最多三行截断，尾部查看按钮；点击后底部弹出抽屉查看全部内容 -->
					<view class="theme-desc mb-20" @click="onViewDesc(item.desc, item.segment.name)">
						<x-text fontSize="13" color="#666" :lines="2" class="theme-desc-text">{{ item.desc }}</x-text>
						<!-- 查看按钮：贴最后一行行尾，点击打开底部抽屉 -->
						<view class="theme-view-btn">
							<x-text fontSize="13" color="#333">查看</x-text>
							<x-icon fontSize="13" color="#333" name="arrow-right-s-line" />
						</view>
					</view>

					<ix-table
					:columns="tableColumns"
					:list="item.symbols"
					headerBgColor="#f5f7fa"
					headerFontColor="#1d2129"
					fontSize="12"
					cellHeight="48"
					>
						<!-- 股票名称：龙头股加标识，涨跌幅放在名称下方 -->
						<template #cell="{ item, key }">
							<view v-if="key == 'name'" class="theme-name-cell" @click="onViewReason(item, item.name)">
								<x-text font-size="13" class="text-weight-b" color="#1d2129">{{ item.name }}</x-text>
								<x-text font-size="12" :color="item.pct >= 0 ? '#EB4436' : '#2F7A55'">{{ item.pct >= 0 ? '+' : '' }}{{ item.pct }}%</x-text>
							</view>
							<!-- 入选原因：内容左对齐（列 align 已设 flex-start，配合插槽渲染），点击在抽屉中查看完整原因 -->
							<text v-else class="theme-reason-cell" @click="onViewReason(item, item.name)">{{ item.reason }}</text>
						</template>
					</ix-table>
				</x-collapse-item>
			</x-collapse>
		</x-sheet>

		<!-- 底部抽屉：查看题材完整描述 -->
		<x-drawer v-model:show="showDesc" :title="drawerTitle" showClose :showFooter="false" size="90%" round="12" contentMargin="0">
			<view class="drawer-desc">
				<x-text fontSize="14" color="#333" lineHeight="1.8">{{ currentDesc }}</x-text>
			</view>
		</x-drawer>

		<!-- 底部抽屉：查看个股入选逻辑，分【精选逻辑（人工）】与【AI入选逻辑】两个区块 -->
		<x-drawer v-model:show="showReason" :title="reasonTitle" showClose showFooter size="90%" round="12" contentMargin="0">
			<view class="drawer-reason">
				
				<!-- AI 分析 / 人工精选逻辑：通过 x-tabs 切换 -->
				<x-tabs
					:list="reasonTabs"
					:modelValue="reasonActive"
					@change="onReasonTabChange"
					fontSize="15"
					activeTitleColor="#e93030"
					titleColor="#888888"
					lineColor="#e93030"
					height="40"
					titlePadding="14px"
				/>

				<view class="reason-block">
					<x-text fontSize="14" color="#333" lineHeight="1.6" class="reason-text">{{ currentReasonByTab }}</x-text>
				</view>

				<!-- 更新时间 -->
				<view class="reason-update">
					<x-text fontSize="13" color="#999">更新时间：{{ updateTime }}</x-text>
				</view>
			</view>

			<!-- 底部操作栏：查看完整分析 -->
			<template #footer>
				<view class="drawer-footer-btn">
					<x-button skin="outline" fontColor="#e93030" block @click="onViewFullAnalysis">查看更多分析</x-button>
				</view>
			</template>
		</x-drawer>
	</view>
</template>

<script>
