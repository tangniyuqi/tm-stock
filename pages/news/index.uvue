<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'
import PageHeader from '@/pages/components/PageHeader.uvue'

const keyword = ref<string>('')
const searchSubmitted = ref<boolean>(false)
const isLoading = ref<boolean>(true)
const errorMessage = ref<string>('')

const openHome = () : void => {
	uni.switchTab({ url: '/pages/index/index' })
}

const openThemeQuery = () : void => {
	uni.navigateTo({ url: '/pages/segment/index' })
}

const emptyMessage = computed(() : string => {
	if (searchSubmitted.value && keyword.value.trim().length > 0) {
		return '快讯搜索服务尚未接入'
	}
	return '暂无已授权快讯'
})

const stateCopy = computed(() : string => {
	if (searchSubmitted.value && keyword.value.trim().length > 0) {
		return '当前无法判断是否存在匹配内容；搜索接口与授权资讯数据源完成接入后才会展示结果。'
	}
	return '资讯数据源完成商用授权后，会在这里按来源与时间展示。'
})

const finishInitialLoad = () : void => {
	isLoading.value = false
}

const submitSearch = () : void => {
	searchSubmitted.value = true
	errorMessage.value = ''
}

const clearSearch = () : void => {
	keyword.value = ''
	searchSubmitted.value = false
	errorMessage.value = ''
}

const retryLoad = () : void => {
	errorMessage.value = ''
	finishInitialLoad()
}

onMounted(() => {
	finishInitialLoad()
})
</script>

<template>
	<view class="shell">
		<PageHeader title="快讯" :showBack="false"></PageHeader>
		<scroll-view class="page" scroll-y="true">
		<view class="header">
			<view class="section-tabs">
				<view class="section-tab" @click="openHome"><text class="section-tab-copy">首页</text></view>
				<view class="section-tab section-tab-active"><text class="section-tab-copy active-copy">快讯</text></view>
				<view class="section-tab" @click="openThemeQuery"><text class="section-tab-copy">题材库</text></view>
			</view>
			<text class="title">已授权资讯</text>
			<text class="subtitle">仅展示来源授权和出处信息齐全的客观资讯。</text>
		</view>

		<view class="search-card">
			<input
				v-model="keyword"
				class="search-input"
				confirm-type="search"
				maxlength="50"
				placeholder="搜索快讯"
				@confirm="submitSearch"
			/>
			<view class="search-actions">
				<text v-if="keyword.length > 0" class="clear-action" @click="clearSearch">清除</text>
				<text class="search-action" @click="submitSearch">搜索</text>
			</view>
		</view>

		<view v-if="isLoading" class="skeleton-list">
			<view v-for="item in 5" :key="item" class="skeleton-card">
				<view class="skeleton skeleton-title"></view>
				<view class="skeleton skeleton-line"></view>
				<view class="skeleton skeleton-line short"></view>
			</view>
		</view>

		<view v-else-if="errorMessage.length > 0" class="state-card">
			<text class="state-title">加载失败</text>
			<text class="state-copy">{{ errorMessage }}</text>
			<text class="retry-action" @click="retryLoad">重新加载</text>
		</view>

		<view v-else class="state-card">
			<text class="state-title">{{ emptyMessage }}</text>
			<text class="state-copy">{{ stateCopy }}</text>
		</view>

		<view class="notice">
			<text class="notice-copy">本平台为公开信息聚合与历史数据统计，不构成任何投资建议。</text>
		</view>
		</scroll-view>
	</view>
</template>

