<script lang="ts" setup>
import { aiBrandColor, aiMutedColor } from '../ai-theme.uts'
import { computed, ref, watch } from 'vue'
import { AIReport, AIReportSection, isValidAIReport } from '../../libs/ai.uts'
import { AIReportSourceEntry, aiReportSources } from '../../libs/ai-report-presentation.uts'
import { formatMillis } from '../../libs/theme.uts'
import { openSafeExternalUrl } from '../../libs/external-link.uts'
import AIReportTools from './AIReportTools.uvue'
import AIReportDossierPanel from './AIReportDossierPanel.uvue'
import AIReportComparisonPanel from './AIReportComparisonPanel.uvue'
import AIReportInputPanel from './AIReportInputPanel.uvue'

type AIReportPanelProps = { report : AIReport, sessionToken ?: string }
defineOptions({ name: 'AIReportPanel' })
const props = withDefaults(defineProps<AIReportPanelProps>(), { sessionToken: '' })
const emit = defineEmits<{unauthorized: []}>()
const sectionKey = ref<string>('all')
const safeReport = computed(() : AIReport | null => {
	if (props.report == null || !isValidAIReport(props.report, props.report.taskId)) return null
	return props.report
})
const visibleSections = computed(() : AIReportSection[] => {
	if (safeReport.value == null) return [] as AIReportSection[]
	return safeReport.value!.sections.filter((section : AIReportSection) : boolean => sectionKey.value == 'all' || section.key == sectionKey.value)
})
const sources = computed(() : AIReportSourceEntry[] => safeReport.value == null ? [] as AIReportSourceEntry[] : aiReportSources(safeReport.value!))
const selectSection = (key : string) : void => {
	if (['all', 'definition', 'timeline', 'segment', 'companies', 'sources', 'dossier', 'comparison', 'inputs'].includes(key)) sectionKey.value = key
}
const openSource = (url : string) : void => { openSafeExternalUrl(url) }
watch(() : AIReport => props.report, () => { sectionKey.value = 'all' }, { flush: 'sync' })
watch(() : string => props.sessionToken, () => { sectionKey.value = 'all' }, { flush: 'sync' })
</script>

<template>
	<view v-if="safeReport != null">
		<x-sheet :margin="16" :padding="16" :round="18" dark-color="#ffffff">
			<text class="report-heading text-size-lg text-weight-b">{{ safeReport!.subjectName }}</text>
			<text class="report-meta mt-8">AI 生成 · {{ safeReport!.disclosure.modelName }}</text>
			<text class="report-meta mt-8">备案或上线编号：{{ safeReport!.disclosure.filingNo }}</text>
			<text class="report-meta mt-8">生成时点：{{ formatMillis(safeReport!.generatedAt) }}</text>
			<text class="report-meta mt-12">报告章节（仅切换显示，不重新生成）</text>
			<view class="ai-section-tabs">
				<x-button :color="sectionKey == 'all' ? aiBrandColor : aiMutedColor" class="ai-section-tab" height="44" :skin="sectionKey == 'all' ? 'thin' : 'text'" @click="selectSection('all')" round="10" font-size="14">全部章节</x-button>
				<x-button :color="sectionKey == section.key ? aiBrandColor : aiMutedColor" v-for="section in safeReport!.sections" :key="section.key" class="ai-section-tab" height="44" :skin="sectionKey == section.key ? 'thin' : 'text'" @click="selectSection(section.key)" round="10" font-size="14">{{ section.title }}</x-button>
				<x-button :color="sectionKey == 'sources' ? aiBrandColor : aiMutedColor" class="ai-section-tab" height="44" :skin="sectionKey == 'sources' ? 'thin' : 'text'" @click="selectSection('sources')" round="10" font-size="14">来源清单</x-button>
				<x-button v-if="sessionToken != ''" :color="sectionKey == 'inputs' ? aiBrandColor : aiMutedColor" class="ai-section-tab" height="44" :skin="sectionKey == 'inputs' ? 'thin' : 'text'" @click="selectSection('inputs')" round="10" font-size="14">上游调用记录</x-button>
				<x-button :color="sectionKey == 'dossier' ? aiBrandColor : aiMutedColor" v-if="safeReport!.dossierReview != null" class="ai-section-tab" height="44" :skin="sectionKey == 'dossier' ? 'thin' : 'text'" @click="selectSection('dossier')" round="10" font-size="14">专题字段核验</x-button>
				<x-button :color="sectionKey == 'comparison' ? aiBrandColor : aiMutedColor" v-if="safeReport!.dossierReview != null && safeReport!.dossierReview!.comparison != null" class="ai-section-tab" height="44" :skin="sectionKey == 'comparison' ? 'thin' : 'text'" @click="selectSection('comparison')" round="10" font-size="14">两卡对照</x-button>
			</view>
		</x-sheet>
		<x-sheet v-for="section in visibleSections" :key="section.key" :margin="16" :padding="16" :round="18" dark-color="#ffffff">
			<text class="report-heading text-size-g text-weight-b">{{ section.title }}</text>
			<text v-if="section.aiGenerated" class="report-meta mt-4">AI 整理 · 授权资料逐字摘录</text>
			<text v-else class="report-meta mt-4">资料库人工审核 · 代码排序 · 未接入行情数据</text>
			<view v-for="(quote, index) in section.quotes" :key="index" class="ai-quote-block">
				<text class="report-quote">{{ quote.text }}</text>
				<text class="report-meta mt-8">来源：{{ quote.sourceType }} · 采集时点：{{ formatMillis(quote.collectedAt) }}</text>
				<x-button :color="aiMutedColor" class="mt-8" skin="text" height="44" @click="openSource(quote.sourceUrl)" round="10" font-size="14">查看原文</x-button>
			</view>
			<view v-if="section.companies != null">
				<view v-for="(company, companyIndex) in section.companies!" :key="companyIndex" class="mt-16">
					<text class="report-heading">{{ company.name }}（{{ company.code }}）</text>
					<text class="report-meta mt-8">归属：{{ company.node }}</text>
					<view v-for="(evidence, evidenceIndex) in company.evidence" :key="evidenceIndex" class="mt-8">
						<text class="report-meta">{{ evidence.trimmed ? '原文节选' : '原文摘录' }}</text>
						<text class="report-quote mt-4">{{ evidence.text }}</text>
						<text class="report-meta mt-8">来源：{{ evidence.sourceType }} · 采集时点：{{ formatMillis(evidence.collectedAt) }}</text>
						<x-button :color="aiMutedColor" class="mt-8" skin="text" height="44" @click="openSource(evidence.sourceUrl)" round="10" font-size="14">查看原文</x-button>
					</view>
				</view>
			</view>
		</x-sheet>
		<x-sheet v-if="sectionKey == 'sources'" :margin="16" :padding="16" :round="18" dark-color="#ffffff">
			<text class="report-heading text-weight-b">出处条目 {{ sources.length }} 项</text>
			<text class="report-meta mt-8">按报告正文出现顺序归集；字段核验与两卡对照的出处另见各核验项。来源类型、链接和采集时点相同才合并，条目数不代表独立发布者数量或核验结论。</text>
			<view v-for="(source, index) in sources" :key="index" class="mt-16">
				<text class="report-meta">{{ index + 1 }} · {{ source.sourceType }} · 采集时点：{{ formatMillis(source.collectedAt) }}</text>
				<text class="report-meta mt-4">本报告引用 {{ source.references }} 处</text>
				<x-button :color="aiMutedColor" class="mt-8" height="44" :block="true" skin="text" @click="openSource(source.sourceUrl)" round="10" font-size="14">查看该出处原文</x-button>
			</view>
		</x-sheet>
		<AIReportDossierPanel v-if="safeReport!.dossierReview != null && (sectionKey == 'all' || sectionKey == 'dossier')" :review="safeReport!.dossierReview!" :generated-at="safeReport!.generatedAt"></AIReportDossierPanel>
		<AIReportComparisonPanel v-if="safeReport!.dossierReview != null && safeReport!.dossierReview!.comparison != null && (sectionKey == 'all' || sectionKey == 'comparison')" :review="safeReport!.dossierReview!" :generated-at="safeReport!.generatedAt"></AIReportComparisonPanel>
		<AIReportTools :report="safeReport!" :session-token="sessionToken"></AIReportTools>
		<AIReportInputPanel v-if="sectionKey == 'inputs'" :task-id="safeReport!.taskId" :subject-id="safeReport!.subjectId" :session-token="sessionToken" @unauthorized="emit('unauthorized')"></AIReportInputPanel>
	</view>
	<view v-else class="pa-16"><text class="report-meta">报告格式暂不可用，请重新核对。</text></view>
</template>

<style lang="scss" scoped>
@import "../ai-theme.scss";
.report-heading { color: #1f2329; font-size: 17px; font-weight: 600; line-height: 26px; }
.report-meta { color: #6b7280; font-size: 13px; line-height: 20px; }
.report-quote { color: #1f2329; font-size: 15px; line-height: 24px; white-space: pre-wrap; }
</style>
