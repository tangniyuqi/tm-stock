<script lang="ts" setup>
import { ref, watch, nextTick, onMounted, onBeforeUnmount } from 'vue'
import { AIConversationApi } from '../../libs/ai-conversation-api.uts'
import { AIConversation, AIConversationSummary, AIConversationMessage, AIPendingConversation, isAIConversationTitle, aiConversationError, conversationPartition, readPendingConversation, reserveConversation, clearPendingConversation } from '../../libs/ai-conversation.uts'
import { currentAIMemberToken } from '../../libs/ai-session.uts'
import { formatMillis } from '../../libs/theme.uts'
import AIConversationTaskPanel from './AIConversationTaskPanel.uvue'
import AIQuestionPanel from './AIQuestionPanel.uvue'
import AIConversationDossiersPanel from './AIConversationDossiersPanel.uvue'
import AISkillPanel from './AISkillPanel.uvue'
import AIConversationHistory from './AIConversationHistory.uvue'
import { isAISkillKey } from '../../libs/ai-skills.uts'

type ConversationProps = { sessionToken : string, refreshKey? : number, activeTab? : string, windowWidth? : number, reportInputActive? : boolean, allowDock? : boolean }
defineOptions({name: 'AIConversationPanel'})
const props = withDefaults(defineProps<ConversationProps>(), { refreshKey: 0, activeTab: 'conversation', windowWidth: 0, reportInputActive: false, allowDock: true })
const emit = defineEmits<{ task: [id : number], reportQuestion: [id : number, seq : number], selected: [], context: [id : number], archived: [value : boolean], unauthorized: [], skillSelected: [] }>()
const rows = ref<AIConversationSummary[]>([] as AIConversationSummary[])
const selected = ref<AIConversation | null>(null)
const messages = ref<AIConversationMessage[]>([] as AIConversationMessage[])
const title = ref<string>('')
const renameTitle = ref<string>('')
const archived = ref<boolean>(false)
const hasMore = ref<boolean>(false)
const nextBefore = ref<number>(0)
const nextAfter = ref<number>(0)
const moreMessages = ref<boolean>(false)
const loading = ref<boolean>(false)
const loadingMessages = ref<boolean>(false)
const busy = ref<boolean>(false)
const ready = ref<boolean>(false)
const message = ref<string>('')
const pending = ref<AIPendingConversation | null>(null)
const dossierRefresh = ref<number>(0)
const savedDossierExpanded = ref<boolean>(false)
const wide = ref<boolean>(false)
const historyVisible = ref<boolean>(false)
const skillsVisible = ref<boolean>(false)
const scrollTarget = ref<string>('')
let scrollRequest : number = 0
const resetScroll = () : void => { scrollRequest++; scrollTarget.value = '' }
const scrollToBottom = () : void => {
	if (selected.value == null || props.activeTab != 'conversation' || !current(generation, props.sessionToken)) return
	const request : number = ++scrollRequest; const round : number = generation; const token : string = props.sessionToken; const id : number = selected.value!.id
	// 先清空目标，使用户手动向上阅读后再次点击同一锚点仍然生效。
	scrollTarget.value = ''
	nextTick(() => {
		if (request == scrollRequest && current(round, token) && props.activeTab == 'conversation' && selected.value != null && selected.value!.id == id) scrollTarget.value = 'ai-conversation-bottom'
	})
}
const updateLayout = () : void => {
	wide.value = (props.windowWidth > 0 ? props.windowWidth : uni.getWindowInfo().windowWidth) >= 960
	if (wide.value) historyVisible.value = false
}
let active : boolean = true
let generation : number = 0
let detailGeneration : number = 0
let partition : string = ''
let refreshPending : boolean = false
let summaryRefreshPending : boolean = false

const current = (round : number, token : string) : boolean => active && generation == round && token.length > 0 && token == props.sessionToken && token == currentAIMemberToken()
const activeSkill = ref<string>('material_qa')
const selectSkill = (key : string) : void => { if (isAISkillKey(key)) { activeSkill.value = key; skillsVisible.value = false; emit('skillSelected') } }
const questionSeq = ref<number>(0)
const questionRequest = ref<number>(0)
const resetDetail = () : void => { detailGeneration++; refreshPending = false; selected.value = null; messages.value = [] as AIConversationMessage[]; nextAfter.value = 0; moreMessages.value = false; loadingMessages.value = false; renameTitle.value = ''; questionSeq.value = 0; questionRequest.value = 0; dossierRefresh.value = 0; savedDossierExpanded.value = false }
const clearDetail = () : void => { resetScroll(); skillsVisible.value = false; resetDetail(); activeSkill.value = 'material_qa'; emit('selected'); emit('context', 0); emit('archived', false) }
const accept = (code : number) : boolean => {
	if (code == 40100 || code == 40101 || code == 40301) { generation++; historyVisible.value = false; clearDetail(); rows.value = [] as AIConversationSummary[]; title.value = ''; pending.value = null; ready.value = false; busy.value = false; loading.value = false; emit('unauthorized'); return false }
	return true
}
const loadMessages = (more : boolean) : void => {
	if (selected.value == null || loadingMessages.value || !current(generation, props.sessionToken) || (more && !moreMessages.value)) return
	const round : number = generation; const detail : number = detailGeneration; const token : string = props.sessionToken; const id : number = selected.value!.id; const cursor : number = more ? nextAfter.value : 0
	loadingMessages.value = true
	AIConversationApi.messages(id, cursor).then((r) => {
		if (!current(round, token) || detail != detailGeneration || !accept(r.code)) return
		loadingMessages.value = false
		if (r.code != 0 || r.data == null) { message.value = aiConversationError(r.code); return }
		messages.value = more ? messages.value.concat(r.data!.items) : r.data!.items; nextAfter.value = r.data!.nextAfterSeq; moreMessages.value = r.data!.hasMore
	}).catch(() => { if (current(round, token) && detail == detailGeneration) { loadingMessages.value = false; message.value = aiConversationError(50001) } })
}
const loadList = (more : boolean, preserveSelection : boolean) : void => {
	if (busy.value || loading.value || !current(generation, props.sessionToken) || (more && !hasMore.value)) return
	if (!more) {
		summaryRefreshPending = false
		if (!preserveSelection) { generation++; if (selected.value != null) clearDetail(); else resetDetail(); rows.value = [] as AIConversationSummary[] }
		ready.value = false; hasMore.value = false; nextBefore.value = 0
	}
	const round : number = generation; const token : string = props.sessionToken; const cursor : number = more ? nextBefore.value : 0; const filter : boolean = archived.value
	loading.value = true; message.value = ''
	AIConversationApi.list(cursor, filter).then((r) => {
		if (!current(round, token) || !accept(r.code)) return
		loading.value = false
		if (r.code != 0 || r.data == null) { message.value = aiConversationError(r.code); return }
		rows.value = more ? rows.value.concat(r.data!.items) : r.data!.items; hasMore.value = r.data!.hasMore; nextBefore.value = r.data!.nextBeforeId; ready.value = true
	}).catch(() => { if (current(round, token)) { loading.value = false; message.value = aiConversationError(50001) } })
}
const list = (more : boolean) : void => { loadList(more, false) }
const refreshRows = () : void => {
	// 创建收据不含列表摘要；独立读取当前服务端列表，不能为同步列表清掉已打开会话。
	summaryRefreshPending = true
	if (!busy.value && !loading.value) loadList(false, true)
}
const open = (id : number, syncList : boolean) : void => {
	if (busy.value || !current(generation, props.sessionToken)) return
	clearDetail(); message.value = ''; const detail : number = detailGeneration; const round : number = generation; const token : string = props.sessionToken
	loadingMessages.value = true
	AIConversationApi.detail(id).then((r) => {
		if (!current(round, token) || detail != detailGeneration || !accept(r.code)) return
		loadingMessages.value = false
		if (r.code != 0 || r.data == null) { message.value = aiConversationError(r.code); return }
		selected.value = r.data!; historyVisible.value = false; renameTitle.value = r.data!.title; emit('context', r.data!.id); emit('archived', r.data!.archived); loadMessages(false)
		if (syncList) refreshRows()
	}).catch(() => { if (current(round, token) && detail == detailGeneration) { loadingMessages.value = false; message.value = aiConversationError(50001) } })
}
const refreshLinkedHistory = () : void => {
	if (selected.value == null || !current(generation, props.sessionToken)) return
	// 写请求/归档确认尚未结束时只合并刷新通知，不能使原响应轮次失效。
	if (busy.value) { refreshPending = true; return }
	refreshPending = false
	const round : number = generation; const detail : number = ++detailGeneration; const token : string = props.sessionToken; const id : number = selected.value!.id
	loadingMessages.value = true
	AIConversationApi.detail(id).then((r) => {
		if (!current(round, token) || detail != detailGeneration || !accept(r.code)) return
		loadingMessages.value = false
		if (r.code != 0 || r.data == null) { message.value = aiConversationError(r.code); return }
		// 消息刷新只同步未编辑的标题；用户在请求前或等待中输入的草稿不能被覆盖。
		const titleUnchanged : boolean = selected.value != null && renameTitle.value == selected.value!.title
		selected.value = r.data!
		if (titleUnchanged) renameTitle.value = r.data!.title
		// 当前归档状态也须同步报告区，避免保留已失效的新追问入口。
		emit('archived', r.data!.archived)
		loadMessages(false)
	}).catch(() => { if (current(round, token) && detail == detailGeneration) { loadingMessages.value = false; message.value = aiConversationError(50001) } })
}
const filter = () : void => { if (!busy.value && !loading.value) { archived.value = !archived.value; list(false) } }
const finishReceipt = async (round : number, token : string, id : number, key : string) : Promise<void> => {
	if (!current(round, token)) return
	const cleared : boolean = await clearPendingConversation(partition, key)
	if (!current(round, token)) return
	if (!cleared) { busy.value = false; message.value = '会话已找到，本地原键仍保留，请继续核查'; return }
	pending.value = null; title.value = ''; busy.value = false; open(id, true)
}
const create = async () : Promise<void> => {
	if (!ready.value || busy.value || loading.value || archived.value || pending.value != null || !isAIConversationTitle(title.value) || !current(generation, props.sessionToken)) return
	busy.value = true; message.value = ''; const round : number = generation; const token : string = props.sessionToken; const originalPartition : string = partition
	try {
		const original : AIPendingConversation | null = await reserveConversation(originalPartition, title.value)
		if (!current(round, token)) {
			// 尚未发HTTP，只能清除本次从未发送的键，不能动其它待核查记录。
			if (original != null) await clearPendingConversation(originalPartition, original.key)
			return
		}
		if (original == null) { pending.value = readPendingConversation(partition); busy.value = false; message.value = '未能安全保存会话原键，未发送新建请求'; return }
		pending.value = original
		const r = await AIConversationApi.create(original.key, original.title)
		if (!current(round, token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null) { busy.value = false; message.value = aiConversationError(r.code); return }
		await finishReceipt(round, token, r.data!.id, original.key)
	} catch (_) { if (current(round, token)) { busy.value = false; try { pending.value = readPendingConversation(partition) } catch (_) { ready.value = false }; message.value = '新建结果未确认，请保留本机记录并查询原键；未自动重发' } }
}
const check = async () : Promise<void> => {
	if (busy.value || pending.value == null || !current(generation, props.sessionToken)) return
	busy.value = true; const round : number = generation; const token : string = props.sessionToken; const key : string = pending.value!.key
	try {
		const r = await AIConversationApi.receipt(key)
		if (!current(round, token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null) { busy.value = false; message.value = aiConversationError(r.code); return }
		await finishReceipt(round, token, r.data!.id, key)
	} catch (_) { if (current(round, token)) { busy.value = false; message.value = aiConversationError(50001) } }
}
const rename = async () : Promise<void> => {
	if (busy.value || loadingMessages.value || selected.value == null || selected.value!.archived || !isAIConversationTitle(renameTitle.value) || !current(generation, props.sessionToken)) return
	busy.value = true; const round : number = generation; const token : string = props.sessionToken; const detail : number = detailGeneration; const id : number = selected.value!.id; const version : number = selected.value!.version
	try {
		const r = await AIConversationApi.rename(id, version, renameTitle.value)
		if (!current(round, token) || detail != detailGeneration || !accept(r.code)) return
		busy.value = false
		if (r.code != 0 || r.data == null) { clearDetail(); message.value = aiConversationError(r.code); return }
		selected.value = r.data!; message.value = '标题已更新，历史列表重新查询后同步'
	} catch (_) { if (current(round, token) && detail == detailGeneration) { busy.value = false; clearDetail(); message.value = aiConversationError(50001) } }
}
const archive = () : void => {
	if (busy.value || loadingMessages.value || selected.value == null || selected.value!.archived || !current(generation, props.sessionToken)) return
	busy.value = true; const round : number = generation; const token : string = props.sessionToken; const detail : number = detailGeneration; const id : number = selected.value!.id; const version : number = selected.value!.version
	uni.showModal({title: '归档当前会话', content: '归档后仍可查询历史，不会删除报告，也不会取消已创建任务。有未确认生成意图时无法归档。', confirmText: '确认归档', cancelText: '暂不归档', success: (decision) => {
		if (!current(round, token) || detail != detailGeneration) return
		if (!decision.confirm) { busy.value = false; return }
		AIConversationApi.archive(id, version).then((r) => {
			if (!current(round, token) || detail != detailGeneration || !accept(r.code)) return
			busy.value = false; clearDetail(); message.value = r.code == 0 ? '会话已归档，请切换到已归档记录查询' : aiConversationError(r.code)
		}).catch(() => { if (current(round, token)) { busy.value = false; clearDetail(); message.value = aiConversationError(50001) } })
	}, fail: () => { if (current(round, token)) busy.value = false }})
}
const openTask = (item : AIConversationMessage) : void => { if (!busy.value && item.kind == 'task' && selected.value != null && current(generation, props.sessionToken)) emit('task', item.taskId) }
const openQuestion = (item : AIConversationMessage) : void => { if (!busy.value && item.kind == 'question' && item.skill == 'material_qa' && selected.value != null && current(generation,props.sessionToken)) { emit('skillSelected'); activeSkill.value = 'material_qa'; questionSeq.value = item.seq; questionRequest.value++ } }
const openReportQuestion = (item : AIConversationMessage) : void => {
	if (!busy.value && item.kind == 'question' && item.skill == 'report_qa' && selected.value != null && current(generation,props.sessionToken)) emit('reportQuestion', item.taskId, item.seq)
}
watch(() : number => props.refreshKey, () => { refreshLinkedHistory() })
watch(() : string => props.activeTab, () => { resetScroll(); historyVisible.value = false; skillsVisible.value = false })
watch(() : boolean => busy.value, (value : boolean) => { if (!value && refreshPending) refreshLinkedHistory() })
watch(() : boolean => busy.value || loading.value, (value : boolean) => { if (!value && summaryRefreshPending) refreshRows() })
watch(() : string => props.sessionToken, () => {
	resetScroll()
	historyVisible.value = false
	skillsVisible.value = false
	generation++; summaryRefreshPending = false; resetDetail(); activeSkill.value = 'material_qa'; rows.value = [] as AIConversationSummary[]; title.value = ''; pending.value = null; ready.value = false; busy.value = false; loading.value = false; hasMore.value = false; archived.value = false
	emit('context', 0)
	partition = conversationPartition(props.sessionToken)
	try { pending.value = readPendingConversation(partition); list(false) } catch (_) { message.value = '本机会话原键记录不可读取，暂不新建；请保留记录联系维护者核查' }
}, {immediate: true})
watch(() : number => props.windowWidth, () => { updateLayout() })
onMounted(() => { updateLayout() })
onBeforeUnmount(() => { active = false; generation++; summaryRefreshPending = false; resetDetail(); rows.value = [] as AIConversationSummary[]; title.value = ''; pending.value = null; emit('context', 0) })
</script>

<template>
	<view class="conversation-workspace" :class="wide ? 'conversation-wide' : ''">
		<view v-if="wide" class="conversation-sidebar" :style="activeTab == 'conversation' ? '' : 'display: none;'">
			<scroll-view scroll-y="true" class="conversation-history-scroll">
			<AIConversationHistory :rows="rows" :title="title" :archived="archived" :pending="pending != null" :ready="ready" :loading="loading" :busy="busy" :has-more="hasMore" :selected-id="selected == null ? 0 : selected!.id" :message="message" @title="title = $event" @refresh="list(false)" @filter="filter" @create="create" @check="check" @open="open($event, false)" @more="list(true)"></AIConversationHistory>
			</scroll-view>
		</view>
		<x-drawer v-if="!wide" :show="historyVisible" @update:show="historyVisible = $event" title="会话历史" position="left" size="88%" :show-close="true" content-margin="0">
			<AIConversationHistory :rows="rows" :title="title" :archived="archived" :pending="pending != null" :ready="ready" :loading="loading" :busy="busy" :has-more="hasMore" :selected-id="selected == null ? 0 : selected!.id" :message="message" @title="title = $event" @refresh="list(false)" @filter="filter" @create="create" @check="check" @open="open($event, false)" @more="list(true)"></AIConversationHistory>
		</x-drawer>
		<!-- 固定报告输入占据视口底部，必须缩小阅读视口；仅在内容末尾留白不能防止按钮被覆盖。 -->
		<scroll-view scroll-y="true" :scroll-into-view="scrollTarget" class="conversation-main" :style="reportInputActive && activeTab == 'conversation' ? 'margin-bottom: calc(240px + env(safe-area-inset-bottom));' : ''">
		<view :style="activeTab == 'conversation' ? '' : 'display: none;'">
		<view v-if="!wide" class="px-16 mt-16"><x-button height="44" :block="true" skin="outline" @click="historyVisible = true">会话历史 / 新建</x-button></view>
	<x-sheet :margin="16" :padding="16" :round="12" dark-color="#ffffff">
		<view v-if="selected == null && !loadingMessages">
			<text class="conversation-title text-weight-b">选择会话，开始查阅资料</text>
			<text class="conversation-copy mt-8">{{ wide ? '从左侧打开或新建会话。' : '从上方“会话历史 / 新建”打开或新建会话。' }}仅限获授权事实资料；报告追问从本人当前可读报告进入。</text>
		</view>
		<text v-if="loadingMessages" class="conversation-copy mt-12">正在核对会话及消息…</text>
		<view v-if="selected != null" class="mt-16">
			<text class="conversation-title text-weight-b">当前会话：{{ selected!.title }}</text>
			<view v-if="!selected!.archived" class="mt-8">
				<x-input :model-value="renameTitle" @update:modelValue="renameTitle = $event" :maxlength="80" height="44" placeholder="新的会话标题" :disabled="busy || loadingMessages"></x-input>
				<x-button class="mt-8" height="44" :block="true" skin="outline" :disabled="busy || loadingMessages || !isAIConversationTitle(renameTitle)" @click="rename">保存会话标题</x-button>
				<x-button class="mt-8" height="44" :block="true" skin="outline" :disabled="busy || loadingMessages" @click="archive">归档当前会话</x-button>
			</view>
			<AIConversationDossiersPanel :key="selected!.id" :session-token="sessionToken" :conversation-id="selected!.id" :enabled="activeTab == 'conversation'" :refresh-key="dossierRefresh" @expanded="savedDossierExpanded = $event" @unauthorized="emit('unauthorized')"></AIConversationDossiersPanel>
			<text v-if="messages.length == 0 && !loadingMessages" class="conversation-copy mt-12">当前会话暂无消息。此处不展示模拟回答。</text>
			<view v-for="item in messages" :key="item.seq" class="mt-12">
				<text class="conversation-copy">消息 #{{ item.seq }} · {{ formatMillis(item.createdAt) }}</text>
				<text v-if="item.kind == 'question'" class="conversation-title mt-4">历史提问：{{ item.question }}</text>
				<x-button v-if="item.kind == 'question' && item.skill == 'material_qa'" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="openQuestion(item)">查询问题状态 #{{ item.seq }}</x-button>
				<x-button v-if="item.kind == 'question' && item.skill == 'report_qa'" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="openReportQuestion(item)">查询报告追问 #{{ item.seq }}</x-button>
				<text v-if="item.kind == 'task'" class="conversation-title mt-4">{{ item.skill == 'light' ? '轻度' : '深度' }}资料任务 · {{ item.subjectType == 'theme' ? '题材' : '专题' }} #{{ item.subjectId }}</text>
				<x-button v-if="item.kind == 'task'" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="openTask(item)">查看关联任务 #{{ item.taskId }}</x-button>
			</view>
			<x-button v-if="moreMessages" class="mt-8" height="44" :block="true" :disabled="loadingMessages || busy" @click="loadMessages(true)">继续读取会话消息</x-button>
		</view>
		<text v-if="message != ''" class="conversation-copy mt-12">{{ message }}</text>
	</x-sheet>
		</view>
		<view :style="activeTab == 'tasks' ? '' : 'display: none;'"><slot name="tasks"></slot></view>
		<!-- 报告及进度由原页面持有，移动布局不会重复挂载或触发第二条订阅。 -->
		<slot name="result"></slot>
		<view class="conversation-composer" :style="activeTab == 'conversation' ? '' : 'display: none;'">
	<view v-if="selected != null" :style="activeSkill == 'material_qa' ? '' : 'display: none;'">
		<AIQuestionPanel :key="selected!.id.toString() + '_' + questionRequest.toString()" :session-token="sessionToken" :conversation-id="selected!.id" :archived="selected!.archived" :question-seq="questionSeq" :dossier-enabled="activeTab == 'conversation'" :dock-input="allowDock && activeTab == 'conversation' && activeSkill == 'material_qa' && !reportInputActive && !savedDossierExpanded" :dock-left="wide ? 324 : 16" :dock-bottom="60" @saved="refreshLinkedHistory" @dossier-saved="dossierRefresh++" @unauthorized="emit('unauthorized')" @conversation="open($event, false)"></AIQuestionPanel>
	</view>
	<view v-if="selected != null && activeSkill == 'light'">
		<AIConversationTaskPanel :key="selected!.id" :session-token="sessionToken" :conversation-id="selected!.id" :analysis-type="'light'" :archived="selected!.archived" @task="emit('task', $event)" @linked="refreshLinkedHistory" @unauthorized="emit('unauthorized')"></AIConversationTaskPanel>
	</view>
	<view v-if="selected != null && activeSkill == 'deep'">
		<AIConversationTaskPanel :key="selected!.id + '_deep'" :session-token="sessionToken" :conversation-id="selected!.id" :analysis-type="'deep'" :archived="selected!.archived" @task="emit('task', $event)" @linked="refreshLinkedHistory" @unauthorized="emit('unauthorized')"></AIConversationTaskPanel>
	</view>
		</view>
		<view v-if="selected != null && activeTab == 'conversation'" class="conversation-tools-reserve"></view>
		<view id="ai-conversation-bottom" class="conversation-bottom-anchor"></view>
		</scroll-view>
		<view v-if="selected != null && activeTab == 'conversation'" class="conversation-tools" :style="'left:' + (wide ? '324' : '16') + 'px;'">
			<view class="conversation-tool"><x-button height="44" :block="true" skin="outline" @click="skillsVisible = true">技能与范围</x-button></view>
			<view class="conversation-tool ml-8"><x-button height="44" :block="true" skin="outline" @click="scrollToBottom">回到底部</x-button></view>
		</view>
		<x-drawer v-if="selected != null" :show="skillsVisible" @update:show="skillsVisible = $event" title="选择技能与核对范围" position="bottom" size="70%" :show-close="true" content-margin="0">
			<AISkillPanel :active="reportInputActive ? 'report_qa' : activeSkill" @select="selectSkill"></AISkillPanel>
		</x-drawer>
	</view>
</template>

