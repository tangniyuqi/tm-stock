<script lang="ts" setup>
import { ref, watch, onBeforeUnmount } from 'vue'
import { currentAIMemberToken } from '../../libs/ai-session.uts'
import { ThemeApi } from '../../libs/theme-api.uts'
import { ThemeBrief, formatMillis } from '../../libs/theme.uts'
import { AIConversationApi } from '../../libs/ai-conversation-api.uts'
import { isSafeAIId } from '../../libs/ai.uts'
import { AIQAApi } from '../../libs/ai-qa-api.uts'
import { AIQAStatus, AIQAAnswer, AIQAQuote, AIPendingQA, isAIQAQuestion, qaPartition, readPendingQA, reserveQA, clearPendingQA, qaMatchesPending, aiQAStateLabel, aiSourceTypeLabel, aiQAError } from '../../libs/ai-qa.uts'
import { copySafeExternalUrl } from '../../libs/external-link.uts'
import AIQuestionComposer from './AIQuestionComposer.uvue'
import AIDossierPanel from './AIDossierPanel.uvue'

type QAProps = { sessionToken : string, conversationId : number, archived : boolean, questionSeq : number, dockInput? : boolean, dockLeft? : number, dockBottom? : number, dossierEnabled? : boolean }
defineOptions({name:'AIQuestionPanel'})
const props = withDefaults(defineProps<QAProps>(), { dockInput: false, dockLeft: 16, dockBottom: 0, dossierEnabled: true })
const emit = defineEmits<{saved: [], unauthorized: [], conversation: [id : number]}>()
const pending = ref<AIPendingQA | null>(null)
const status = ref<AIQAStatus | null>(null)
const answer = ref<AIQAAnswer | null>(null)
const keyword = ref<string>('')
const themes = ref<ThemeBrief[]>([] as ThemeBrief[])
const subject = ref<ThemeBrief | null>(null)
const dossierExpanded = ref<boolean>(false)
const question = ref<string>('')
const busy = ref<boolean>(false)
const safeStorage = ref<boolean>(false)
const message = ref<string>('')
let active : boolean = true
let generation : number = 0
let boundCID : number = 0
let partition : string = ''

const current = (round : number, token : string) : boolean => active && generation == round && isSafeAIId(boundCID) && boundCID == props.conversationId && token.length > 0 && token == props.sessionToken && token == currentAIMemberToken()
const accept = (code : number) : boolean => {
	if (code == 40100 || code == 40101 || code == 40301) { generation++; status.value = null; answer.value = null; themes.value = [] as ThemeBrief[]; subject.value = null; question.value = ''; keyword.value = ''; pending.value = null; busy.value = false; safeStorage.value = false; emit('unauthorized'); return false }
	return true
}
const applyStatus = (v : AIQAStatus, original : boolean) : boolean => {
	answer.value = null
	if (original && (pending.value == null || pending.value!.conversationId != boundCID || !qaMatchesPending(v,pending.value!))) { status.value = null; message.value = '原问题与本机对象或输入不一致，已停止展示；请保留记录核查'; return false }
	status.value = v; return true
}
const readStatus = async (seq : number) : Promise<void> => {
	if (busy.value || !isSafeAIId(seq) || !current(generation,props.sessionToken)) return
	const round : number = generation; const token : string = props.sessionToken
	busy.value = true; answer.value = null; status.value = null; message.value = ''
	try {
		const r = await AIQAApi.status(boundCID,seq)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null) { message.value = aiQAError(r.code); return }
		applyStatus(r.data!,false)
	} catch (_) { if (current(round,token)) message.value = aiQAError(50001) }
	finally { if (current(round,token)) busy.value = false }
}
const check = async () : Promise<void> => {
	if (busy.value || pending.value == null || pending.value!.conversationId != boundCID || !current(generation,props.sessionToken)) return
	const round : number = generation; const token : string = props.sessionToken; const p : AIPendingQA = pending.value!
	busy.value = true; answer.value = null; status.value = null; message.value = ''
	try {
		const r = await AIQAApi.receipt(boundCID,p.key)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null) { message.value = aiQAError(r.code); return }
		if (applyStatus(r.data!,true)) emit('saved')
	} catch (_) { if (current(round,token)) message.value = aiQAError(50001) }
	finally { if (current(round,token)) busy.value = false }
}
const search = async () : Promise<void> => {
	if (busy.value || props.archived || pending.value != null || !safeStorage.value || !current(generation,props.sessionToken)) return
	const kw : string = keyword.value.trim()
	if (kw.length == 0 || kw.length > 64) { message.value = '请输入不超过64字的题材名称'; return }
	const round : number = generation; const token : string = props.sessionToken
	busy.value = true; themes.value = [] as ThemeBrief[]; subject.value = null; answer.value = null; status.value = null; message.value = ''
	try {
		const r = await ThemeApi.search(kw)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null || !Array.isArray(r.data) || r.data!.length > 50) { message.value = '题材目录暂不可用，请重新查询'; return }
		const seen : number[] = [] as number[]
		for (const item of r.data!) { if (item == null || !isSafeAIId(item.id) || seen.includes(item.id) || typeof item.name != 'string' || item.name.trim().length == 0 || item.name.length > 64) { message.value = '题材目录格式不可用'; return }; seen.push(item.id) }
		themes.value = r.data!; if (themes.value.length == 0) message.value = '未找到题材，请更换名称查询'
	} catch (_) { if (current(round,token)) message.value = '题材目录暂不可用，请重新查询' }
	finally { if (current(round,token)) busy.value = false }
}
const choose = (id : number) : void => {
	if (busy.value || props.archived || pending.value != null || !current(generation,props.sessionToken)) return
	const item : ThemeBrief | null = themes.value.find((v : ThemeBrief) : boolean => v.id == id) ?? null
	if (item == null) return
	subject.value = item; answer.value = null; status.value = null; message.value = ''
}
const submit = async () : Promise<void> => {
	if (busy.value || props.archived || !safeStorage.value || pending.value != null || subject.value == null || !isAIQAQuestion(question.value) || !current(generation,props.sessionToken)) return
	const round : number = generation; const token : string = props.sessionToken; const cid : number = boundCID; const originalPartition : string = partition; const text : string = question.value; const subjectID : number = subject.value!.id
	busy.value = true; status.value = null; answer.value = null; message.value = ''
	try {
		const conv = await AIConversationApi.detail(cid)
		if (!current(round,token) || !accept(conv.code)) return
		if (conv.code != 0 || conv.data == null || conv.data!.archived || props.archived) { message.value = '当前会话不可提问，请重新核对会话；未提交问题'; return }
		const p : AIPendingQA | null = await reserveQA(originalPartition,cid,conv.data!.version,subjectID,0,'material_qa',text)
		if (!current(round,token) || props.archived) { if (p != null) await clearPendingQA(originalPartition,p.key); return }
		if (p == null) { pending.value = readPendingQA(partition); message.value = '无法可靠保存原问题或已有待核查记录，未发送提交'; return }
		pending.value = p
		const r = await AIQAApi.submit(p)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null) { message.value = aiQAError(r.code); return }
		if (applyStatus(r.data!,true)) emit('saved')
	} catch (_) { if (current(round,token)) { try { pending.value = readPendingQA(partition) } catch (_) { safeStorage.value = false }; message.value = '提交结果未确认，请保留本机记录并核查原问题；未自动重发' } }
	finally { if (current(round,token)) busy.value = false }
}
const readAnswer = async () : Promise<void> => {
	if (busy.value || status.value == null || !['answered','refused'].includes(status.value!.state) || !current(generation,props.sessionToken)) return
	const round : number = generation; const token : string = props.sessionToken; const v : AIQAStatus = status.value!
	busy.value = true; answer.value = null; message.value = ''
	try {
		const r = await AIQAApi.answer(boundCID,v.seq)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null || r.data!.state != v.state) { message.value = aiQAError(r.code == 0 ? 50001 : r.code); return }
		answer.value = r.data!
	} catch (_) { if (current(round,token)) message.value = aiQAError(50001) }
	finally { if (current(round,token)) busy.value = false }
}
const openQuote = async (index : number) : Promise<void> => {
	if (busy.value || answer.value == null || status.value == null || index < 0 || index >= answer.value!.quotes.length || !current(generation,props.sessionToken)) return
	const round : number = generation; const token : string = props.sessionToken; const seq : number = status.value!.seq; const original : AIQAQuote = answer.value!.quotes[index]
	busy.value = true; answer.value = null; message.value = ''
	try {
		const r = await AIQAApi.answer(boundCID,seq)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null || r.data!.state != 'answered' || r.data!.quotes.length <= index || JSON.stringify(r.data!.quotes[index]) != JSON.stringify(original)) { busy.value = false; message.value = '当前出处未通过重新核对，未打开链接'; return }
		answer.value = r.data!
		const url : string = r.data!.quotes[index].sourceUrl
		uni.showModal({title:'打开已核对出处',content:'即将前往原文链接，请确认来源：'+url,confirmText:'打开原文',cancelText:'暂不打开',success:(decision) => {
			if (!current(round,token)) return
			busy.value = false
			if (!decision.confirm) return
			// #ifdef WEB
			const target = window.open(url,'_blank'); if (target != null) { target.opener = null; return }
			// #endif
			copySafeExternalUrl(url)
		},fail:() => { if (current(round,token)) busy.value = false }})
	} catch (_) { if (current(round,token)) { busy.value = false; message.value = aiQAError(50001) } }
}
const finish = async () : Promise<void> => {
	if (busy.value || pending.value == null || pending.value!.conversationId != boundCID || !current(generation,props.sessionToken)) return
	const round : number = generation; const token : string = props.sessionToken; const p : AIPendingQA = pending.value!
	busy.value = true; answer.value = null; message.value = ''
	try {
		const r = await AIQAApi.receipt(boundCID,p.key)
		if (!current(round,token) || !accept(r.code)) return
		if (r.code != 0 || r.data == null || !qaMatchesPending(r.data!,p) || !['answered','refused','failed'].includes(r.data!.state)) { status.value = null; message.value = '原问题尚未核实终态，保留原键，未开始新问题'; return }
		const cleared : boolean = await clearPendingQA(partition,p.key)
		if (!current(round,token)) return
		if (!cleared) { message.value = '本机原键已变化，保留记录继续核查'; return }
		pending.value = null; status.value = null; question.value = ''; subject.value = null; themes.value = [] as ThemeBrief[]; keyword.value = ''; message.value = '本地原键已清理，服务端问题历史仍保留'; emit('saved')
	} catch (_) { if (current(round,token)) message.value = '原问题核查或本机存储失败，未开始新问题' }
	finally { if (current(round,token)) busy.value = false }
}
const openPendingConversation = () : void => { if (!busy.value && pending.value != null && current(generation,props.sessionToken)) emit('conversation',pending.value!.conversationId) }
watch(() : string => props.sessionToken+'|'+props.conversationId.toString()+'|'+props.archived.toString(), () => {
	generation++; boundCID = props.conversationId; status.value = null; answer.value = null; themes.value = [] as ThemeBrief[]; subject.value = null; question.value = ''; keyword.value = ''; pending.value = null; busy.value = false; safeStorage.value = false; message.value = ''; partition = qaPartition(props.sessionToken)
	if (!current(generation,props.sessionToken)) return
	try { pending.value = readPendingQA(partition); safeStorage.value = true; if (props.questionSeq > 0) readStatus(props.questionSeq) }
	catch (_) { message.value = '本机原问题记录不可读取，暂不提交；请保留记录联系维护者核查' }
}, {immediate:true})
onBeforeUnmount(() => { active = false; generation++; status.value = null; answer.value = null; themes.value = [] as ThemeBrief[]; subject.value = null; question.value = ''; keyword.value = ''; pending.value = null })
</script>

<template>
	<x-sheet :margin="16" :padding="16" :round="12" dark-color="#ffffff">
		<text class="qa-heading text-weight-b">会话资料问答</text>
		<text class="qa-copy mt-8">仅在所选题材当前获授权资料内查找事实引文，无证据明确拒答，不自动联网。问答不扣积分；新报告须另行报价确认。服务开放状态以实际接口核验为准。</text>
		<text v-if="archived" class="qa-copy mt-8">当前会话已归档，仅可核查已有问题。</text>
		<view v-if="!archived && safeStorage && pending == null" class="mt-12">
			<x-input :model-value="keyword" @update:modelValue="keyword = $event" :maxlength="64" height="44" placeholder="查找本次问答的题材" :disabled="busy"></x-input>
			<x-button class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="search">查询问答题材</x-button>
			<view v-for="item in themes" :key="item.id" class="mt-8">
				<text class="qa-copy">{{ item.name }}</text>
				<x-button class="mt-4" height="44" :block="true" skin="outline" :disabled="busy" @click="choose(item.id)">选择问答题材 #{{ item.id }}</x-button>
			</view>
			<view v-if="subject != null" class="mt-12">
				<AIQuestionComposer :question="question" :scope-label="'当前所选题材：' + subject!.name" placeholder="输入所选资料的事实问题，最多1000字" submit-label="提交本次资料问题（不扣积分）" :busy="busy" :docked="dockInput && !dossierExpanded" :dock-left="dockLeft" :dock-bottom="dockBottom" @change="question = $event" @submit="submit"></AIQuestionComposer>
			</view>
		</view>
		<view v-if="pending != null" class="mt-12">
			<text class="qa-copy">本机保留有原问题，暂不提交第二个。超时或暂未查到不代表未保存。</text>
			<x-button v-if="pending!.conversationId == conversationId" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="check">核查本机原问题</x-button>
			<x-button v-else class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="openPendingConversation">打开待核查会话 #{{ pending!.conversationId }}</x-button>
		</view>
		<text v-if="busy" class="qa-copy mt-12">正在核对本次操作，请勿重复提交；不会展示未经核验的模型原文。</text>
		<view v-if="status != null" class="mt-12">
			<text class="qa-heading">问题 #{{ status!.seq }}：{{ status!.question }}</text>
			<text class="qa-copy mt-4">{{ aiQAStateLabel(status!.state) }} · {{ formatMillis(status!.updatedAt) }}</text>
			<x-button class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="readStatus(status!.seq)">刷新问题状态</x-button>
			<x-button v-if="status!.state == 'answered' || status!.state == 'refused'" class="mt-8" height="44" :block="true" :disabled="busy" @click="readAnswer">核对当前答案</x-button>
		</view>
		<view v-if="answer != null" class="mt-12">
			<text class="qa-heading">{{ answer!.subjectName }}</text>
			<text class="qa-copy mt-4">{{ answer!.template }}</text>
			<text v-if="answer!.aiGenerated" class="qa-copy mt-4">AI 生成 · 模型 {{ answer!.modelName }} · 备案号 {{ answer!.filingNo }}</text>
			<text v-else class="qa-copy mt-4">固定提示，本次未调用模型。</text>
			<view v-for="(q,index) in answer!.quotes" :key="index" class="mt-12">
				<text class="qa-excerpt">{{ q.excerpt }}</text>
				<text class="qa-copy mt-4">{{ aiSourceTypeLabel(q.sourceType) }} · {{ formatMillis(q.collectedAt) }}</text>
				<text class="qa-copy mt-4">{{ q.sourceUrl }}</text>
				<x-button class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="openQuote(index)">重新核对并打开出处 #{{ index + 1 }}</x-button>
			</view>
		</view>
		<x-button v-if="pending != null && pending!.conversationId == conversationId && status != null && qaMatchesPending(status!,pending!) && (status!.state == 'answered' || status!.state == 'refused' || status!.state == 'failed')" class="mt-12" height="44" :block="true" skin="outline" :disabled="busy" @click="finish">核实终态并清理本地原键</x-button>
		<text v-if="message != ''" class="qa-copy mt-12">{{ message }}</text>
		<AIDossierPanel v-if="subject != null" :key="subject!.id" :session-token="sessionToken" :theme-id="subject!.id" :theme-name="subject!.name" :enabled="dossierEnabled" @expanded="dossierExpanded = $event" @unauthorized="emit('unauthorized')"></AIDossierPanel>
		<!-- 留白放在所有答案/错误/操作之后，保证它们可滚动到固定输入上方。 -->
		<view v-if="dockInput && !dossierExpanded && !archived && safeStorage && pending == null && subject != null" class="qa-composer-reserve"></view>
	</x-sheet>
</template>

<style scoped>
.qa-heading { color: #30343c; line-height: 24px; }
.qa-copy { color: #586174; font-size: 14px; line-height: 22px; }
.qa-excerpt { color: #30343c; line-height: 25px; white-space: pre-wrap; }
.qa-composer-reserve { height: 320px; padding-bottom: env(safe-area-inset-bottom); }
</style>
