<script lang="ts" setup>
import { ref, watch, onBeforeUnmount } from 'vue'
import { AIDossierApi } from '../../libs/ai-dossier-api.uts'
import { AIDossierVersionItem, AIDossierView, AIDossierQuote, dossierQuoteFor, dossierError } from '../../libs/ai-dossier.uts'
import { currentAIMemberToken } from '../../libs/ai-session.uts'
import { formatMillis } from '../../libs/theme.uts'
import { copySafeExternalUrl } from '../../libs/external-link.uts'
import AIDossierContent from './AIDossierContent.uvue'
import { AIConversationApi } from '../../libs/ai-conversation-api.uts'
import { AIConversationDossierApi, AIDossierSelection, savedDossierError } from '../../libs/ai-conversation-dossier.uts'

type DossierProps = { sessionToken : string, themeId : number, themeName : string, enabled? : boolean, conversationId? : number, archived? : boolean }
defineOptions({name:'AIDossierPanel'})
const props = withDefaults(defineProps<DossierProps>(), {enabled:true,conversationId:0,archived:false})
const emit = defineEmits<{unauthorized: [], expanded: [value : boolean], saved: []}>()
const expanded = ref<boolean>(false)
const busy = ref<boolean>(false)
const ready = ref<boolean>(false)
const versions = ref<AIDossierVersionItem[]>([] as AIDossierVersionItem[])
const picked = ref<number[]>([] as number[])
const hasMore = ref<boolean>(false)
const nextBefore = ref<number>(0)
const view = ref<AIDossierView | null>(null)
const message = ref<string>('')
const pendingSelection = ref<AIDossierSelection | null>(null)
let alive : boolean = true
let generation : number = 0
const current = (round : number, token : string) : boolean => alive && props.enabled && expanded.value && generation == round && token.length > 0 && token == props.sessionToken && token == currentAIMemberToken()
const reset = () : void => { generation++; expanded.value = false; busy.value = false; ready.value = false; versions.value = [] as AIDossierVersionItem[]; picked.value = [] as number[]; hasMore.value = false; nextBefore.value = 0; view.value = null; pendingSelection.value = null; message.value = ''; emit('expanded',false) }
const discardResults = () : void => { view.value = null; versions.value = [] as AIDossierVersionItem[]; picked.value = [] as number[]; ready.value = false; hasMore.value = false; nextBefore.value = 0 }
const accept = (code : number) : boolean => { if (code == 40100 || code == 40101 || code == 40301) { reset(); emit('unauthorized'); return false }; return true }
const loadVersions = async (more : boolean) : Promise<void> => {
	if (busy.value || !current(generation,props.sessionToken) || more && !hasMore.value) return
	if (!more) { generation++; versions.value = [] as AIDossierVersionItem[]; picked.value = [] as number[]; view.value = null; ready.value = false; hasMore.value = false; nextBefore.value = 0 }
	const round : number = generation; const token : string = props.sessionToken; const cursor : number = more ? nextBefore.value : 0
	busy.value = true; message.value = ''; view.value = null
	try {
		const r = await AIDossierApi.list(props.themeId,cursor)
		if (!current(round,token) || !accept(r.code)) return
		busy.value = false
		if (r.code != 0 || r.data == null) { versions.value = [] as AIDossierVersionItem[]; picked.value = [] as number[]; ready.value = false; hasMore.value = false; message.value = dossierError(r.code); return }
		versions.value = more ? versions.value.concat(r.data!.items) : r.data!.items; ready.value = true; hasMore.value = r.data!.hasMore; nextBefore.value = r.data!.nextBeforeVersion
	} catch (_) { if (current(round,token)) { busy.value = false; discardResults(); message.value = dossierError(50001) } }
}
const toggle = () : void => { if (expanded.value) { reset(); return }; if (!props.enabled || props.sessionToken != currentAIMemberToken()) return; expanded.value = true; emit('expanded',true); loadVersions(false) }
const choose = (version : number) : void => { if (busy.value || !current(generation,props.sessionToken)) return; view.value = null; if (picked.value.includes(version)) picked.value = picked.value.filter((v : number) : boolean => v != version); else if (picked.value.length < 2) picked.value = picked.value.concat([version]); else message.value = '已选择两个版本，请先取消其中一个' }
const read = async (version : number, compare : number) : Promise<void> => {
	if (busy.value || !current(generation,props.sessionToken)) return
	const round : number = ++generation; const token : string = props.sessionToken
	busy.value = true; view.value = null; message.value = ''
	try { const r = await AIDossierApi.view(props.themeId,version,compare); if (!current(round,token) || !accept(r.code)) return; busy.value = false; if (r.code != 0 || r.data == null) { discardResults(); message.value = dossierError(r.code); return }; view.value = r.data! }
	catch (_) { if (current(round,token)) { busy.value = false; discardResults(); message.value = dossierError(50001) } }
}
const comparePicked = () : void => { if (picked.value.length != 2) return; read(Math.min(picked.value[0],picked.value[1]),Math.max(picked.value[0],picked.value[1])) }
const copySource = async (version : number, key : string, field : string) : Promise<void> => {
	if (busy.value || view.value == null || !current(generation,props.sessionToken)) return
	const first : number = view.value!.versions[0].version; const second : number = view.value!.versions.length == 2 ? view.value!.versions[1].version : 0
	const round : number = ++generation; const token : string = props.sessionToken; busy.value = true; view.value = null; message.value = ''
	try { const r = await AIDossierApi.view(props.themeId,first,second); if (!current(round,token) || !accept(r.code)) return; busy.value = false; if (r.code != 0 || r.data == null) { discardResults(); message.value = dossierError(r.code); return }; view.value = r.data!; const q : AIDossierQuote | null = dossierQuoteFor(view.value!,version,key,field); if (q != null) copySafeExternalUrl(q!.sourceUrl) }
	catch (_) { if (current(round,token)) { busy.value = false; discardResults(); message.value = dossierError(50001) } }
}
const save = async () : Promise<void> => {
	if (busy.value || view.value == null || props.conversationId <= 0 || props.archived || pendingSelection.value != null || !current(generation,props.sessionToken)) return
	const selected : AIDossierSelection = {themeId:props.themeId,version:view.value!.versions[0].version,compareVersion:view.value!.versions.length == 2 ? view.value!.versions[1].version : 0}
	const round : number = ++generation; const token : string = props.sessionToken; const cid : number = props.conversationId
	busy.value = true; view.value = null; message.value = ''; pendingSelection.value = selected
	let posted : boolean = false
	try {
		const detail = await AIConversationApi.detail(cid)
		if (!current(round,token) || !accept(detail.code)) return
		if (detail.code != 0 || detail.data == null || detail.data!.archived) { busy.value = false; pendingSelection.value = null; message.value = '当前会话未能通过核对，未发送保存请求'; return }
		posted = true
		const r = await AIConversationDossierApi.save(cid,detail.data!.version,selected)
		if (!current(round,token) || !accept(r.code)) return
		busy.value = false
		if (r.code != 0 || r.data == null) { if (r.code < 50000) pendingSelection.value = null; message.value = savedDossierError(r.code); return }
		pendingSelection.value = null; message.value = '档案引用已保存，可从本会话已保存档案重新核对并打开'; emit('saved')
	} catch (_) { if (current(round,token)) { busy.value = false; if (!posted) pendingSelection.value = null; message.value = posted ? '保存结果未确认，请查询原组合收据；不会自动重发' : '当前会话未能通过核对，未发送保存请求' } }
}
const checkSaved = async () : Promise<void> => {
	if (busy.value || pendingSelection.value == null || !current(generation,props.sessionToken)) return
	const round : number = ++generation; const token : string = props.sessionToken; const selected : AIDossierSelection = pendingSelection.value!
	busy.value = true; view.value = null
	try { const r = await AIConversationDossierApi.receipt(props.conversationId,selected); if (!current(round,token) || !accept(r.code)) return; busy.value = false; if (r.code != 0 || r.data == null) { message.value = savedDossierError(r.code); return }; pendingSelection.value = null; message.value = '已找到原组合保存记录，请从本会话已保存档案重新打开'; emit('saved') }
	catch (_) { if (current(round,token)) { busy.value = false; message.value = '保存收据暂未核实，可再次查询原组合；不会自动重发' } }
}
watch(() : string => props.sessionToken, () => { reset() })
watch(() : number => props.conversationId, () => { reset() })
watch(() : boolean => props.archived, () => { reset() })
watch(() : number => props.themeId, () => { reset() })
watch(() : boolean => props.enabled, () => { reset() })
onBeforeUnmount(() => { alive = false; reset() })
</script>

<template>
	<view class="dossier-panel mt-12">
		<text class="dossier-title text-weight-b">{{ themeName }} · 专题档案</text>
		<text class="dossier-copy mt-4">查阅已获授权的资料卡、原文出处与版本变化。本次查询不调用模型、不扣积分。</text>
		<x-button class="mt-8" height="44" :block="true" skin="outline" @click="toggle">{{ expanded ? '收起专题档案' : '查询可读档案版本' }}</x-button>
		<view v-if="expanded" class="mt-8">
			<text class="dossier-copy">所选版本用于本次档案查阅；资料问答仍在当前题材的授权资料范围内检索。</text>
			<text v-if="busy" class="dossier-copy">正在核对当前资料与版本权限…</text>
			<text v-if="ready && versions.length == 0" class="dossier-copy">当前没有可读的档案版本，可继续使用资料问答；资料不足不表示相关事实不存在。</text>
			<view v-for="item in versions" :key="item.version" class="dossier-version mt-8">
				<text class="dossier-title">版本 {{ item.version }} · 编制于 {{ formatMillis(item.compiledAt) }}</text>
				<view class="dossier-actions mt-8">
					<view class="dossier-action"><x-button height="44" :block="true" skin="outline" :disabled="busy" @click="read(item.version,0)">阅读此版本</x-button></view>
					<view class="dossier-action ml-8"><x-button height="44" :block="true" :skin="picked.includes(item.version) ? 'primary' : 'outline'" :disabled="busy" @click="choose(item.version)">{{ picked.includes(item.version) ? '取消对照' : '加入对照' }}</x-button></view>
				</view>
			</view>
			<x-button v-if="hasMore" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="loadVersions(true)">查询更早的可读版本</x-button>
			<x-button v-if="versions.length > 0" class="mt-8" height="44" :block="true" :disabled="busy || picked.length != 2" @click="comparePicked">对照所选的两个版本（{{ picked.length }}/2）</x-button>
			<x-button class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="loadVersions(false)">重新核对可读版本</x-button>
			<text v-if="message != ''" class="dossier-copy mt-12">{{ message }}</text>
			<x-button v-if="pendingSelection != null" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy" @click="checkSaved">查询原组合保存收据</x-button>
			<x-button v-if="view != null && conversationId > 0 && !archived" class="mt-8" height="44" :block="true" skin="outline" :disabled="busy || pendingSelection != null" @click="save">保存当前档案到本会话（不扣积分）</x-button>
			<AIDossierContent v-if="view != null" :value="view!" :busy="busy" @copy="copySource"></AIDossierContent>
		</view>
	</view>
</template>

<style scoped>
.dossier-panel { padding: 12px; background-color: #f6f8fc; border-radius: 10px; min-width: 0; }
.dossier-version { padding: 12px; background-color: #ffffff; border-radius: 8px; min-width: 0; }
.dossier-title { color: #30343c; font-size: 15px; line-height: 24px; }
.dossier-copy { color: #586174; font-size: 14px; line-height: 23px; }
.dossier-quote { color: #30343c; font-size: 14px; line-height: 25px; white-space: pre-wrap; }
.dossier-actions { flex-direction: row; }
.dossier-action { flex: 1; min-width: 0; }
</style>
