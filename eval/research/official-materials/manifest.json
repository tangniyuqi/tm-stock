  "documents": [
    {
      "key": "uav-regulation-761",
      "title": "无人驾驶航空器飞行管理暂行条例",
      "url": "https://www.caac.gov.cn/XXGK/XXGK/FLFG/202401/t20240115_222642.html",
      "noticeUrl": "https://www.caac.gov.cn/XXGK/XXGK/FLFG/202401/t20240115_222642.html",
      "sourceType": "announcement",
      "collectedAt": 1793690164497,
      "rawSha256": "303694851c8d9e21cfc7c1eedb52b1282524bdfa4e815e917c2fe04fc3420d23",
      "rawBytes": 87936,
      "sourceMediaType": "text/html",
      "extraction": "html-visible-text-blocks-v1",
      "page": null,
      "coverage": "selected-passages-not-full-document",
      "passages": [
        {
          "key": "definition",
          "text": "本条例所称无人驾驶航空器，是指没有机载驾驶员、自备动力系统的航空器。",
          "startByte": 1991,
          "endByte": 2093
        },
        {
          "key": "classification",
          "text": "无人驾驶航空器按照性能指标分为微型、轻型、小型、中型和大型。",
          "startByte": 2096,
          "endByte": 2186
        },
        {
          "key": "territorial_scope",
          "text": "第二条 在中华人民共和国境内从事无人驾驶航空器飞行以及有关活动，应当遵守本条例。",
          "startByte": 1870,
          "endByte": 1988
        },
        {
          "key": "effective_date",
          "text": "第六十三条 本条例自2024年1月1日起施行。",
          "startByte": 36935,
          "endByte": 36990
        },
        {
          "key": "published_date",
          "text": "发文日期：2023-06-28",
          "startByte": 1256,
          "endByte": 1281
        }
      ]
    },
    {
      "key": "storage-manufacturing-plan",
      "title": "新型储能制造业高质量发展行动方案",
      "url": "https://www.miit.gov.cn/cms_files/filemanager/1226211233/attach/20252/408edf011d224d73a889c03c70b180d3.pdf",
      "noticeUrl": "https://www.miit.gov.cn/jgsj/dzs/wjfb/art/2025/art_269983a459934b72a51261cb7b1de958.html",
      "sourceType": "announcement",
      "collectedAt": 1793690165047,
      "rawSha256": "9654923e1c033925f7275135c6f76ac7848090db29e9ee402ccc111101dbee4f",
      "rawBytes": 359288,
      "sourceMediaType": "application/pdf",
      "extraction": "pdfplumber-page-text-joined-soft-lines-v1",
      "page": 1,
      "coverage": "selected-passages-not-full-document",
      "passages": [
        {
          "key": "definition",
          "text": "新型储能制造业是为新型储能提供能量存储、信息处理、安全控制等产品的制造业的总称，以新型电池等蓄能产品和各类新型储能技术为主要领域，也包括电源管理芯片、电力电子器件、热管理和能量控制系统等环节。",
          "startByte": 48,
          "endByte": 336
        }
      ]
    },
    {
